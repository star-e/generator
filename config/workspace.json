        "Sampler": { "header": "cocos/renderer/gfx-base/states/GFXSampler.h" },
        "Viewport": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "Color": { "header": "cocos/renderer/gfx-base/GFXDef.h" },
        "Device": { "header": "cocos/renderer/gfx-base/GFXDevice.h" },
        "RenderPass": { "header": "cocos/renderer/gfx-base/GFXRenderPass.h" },
        "Buffer": { "header": "cocos/renderer/gfx-base/GFXBuffer.h" },
        "Texture": { "header": "cocos/renderer/gfx-base/GFXTexture.h" },
        "Framebuffer": { "header": "cocos/renderer/gfx-base/GFXFramebuffer.h" },
        "Swapchain": { "header": "cocos/renderer/gfx-base/GFXSwapchain.h" }
      }
    },
    {
      "spec": "../spec/extern/scene.spec",
      "backend": "model",
      "types": {
        "DirectionalLight": { "header": "cocos/scene/DirectionalLight.h" },
        "SphereLight": { "header": "cocos/scene/SphereLight.h" },
        "SpotLight": { "header": "cocos/scene/SpotLight.h" },
        "PointLight": { "header": "cocos/scene/PointLight.h" },
        "RangedDirectionalLight": { "header": "cocos/scene/RangedDirectionalLight.h" },
        "Pass": { "header": "cocos/scene/Pass.h" },
        "SubModel": { "header": "cocos/scene/SubModel.h" },
        "Camera": { "header": "cocos/scene/Camera.h" },
        "RenderScene": { "header": "cocos/scene/RenderScene.h" },
        "Model": { "header": "cocos/scene/Model.h" }
      }
    },
    {
      "spec": "../spec/extern/render-window.spec",
      "backend": "model",
      "types": { "RenderWindow": { "header": "cocos/scene/RenderWindow.h" } }
    },
    {
      "spec": "../spec/render/render-graph.spec",
      "backend": "records",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/RenderGraphTypes.h",
      "forwardHeader": "cocos/renderer/pipeline/custom/RenderGraphFwd.h",
      "typescript": "cocos/rendering/custom/render-graph.ts",
      "runtimeFiles": {
        "native/cocos/base/GraphEdges.h": "../runtime/cpp/GraphEdges.h"
      }
    },
    {
      "spec": "../spec/extern/gfx.spec",
      "backend": "model",
      "types": {
        "Type": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "BarrierType": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "AccessFlagBit": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "SampleCount": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "TextureType": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "TextureFlagBit": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "ResolveMode": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "LoadOp": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },

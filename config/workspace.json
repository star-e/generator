{
  "outputRoot": "../build/staging/cocos4",
  "lineEnding": "crlf",
  "preamble": "preamble.txt",
  "types": "../spec/extern/types.json",
  "modules": [
    { "backend": "model", "spec": "../spec/extern/types.spec" },
    {
      "backend": "model",
      "spec": "../spec/extern/containers.spec",
      "types": {
        "map": { "header": "cocos/base/std/container/map.h" },
        "string": { "header": "cocos/base/std/container/string.h" },
        "vector": { "header": "cocos/base/std/container/vector.h" }
      }
    },
    {
      "backend": "model",
      "spec": "../spec/extern/pmr-containers.spec",
      "types": {
        "map": { "header": "cocos/base/std/container/map.h" },
        "vector": { "header": "cocos/base/std/container/vector.h" }
      }
    },
    {
      "backend": "model",
      "spec": "../spec/extern/sets.spec",
      "types": { "PmrTransparentSet": { "header": "cocos/renderer/pipeline/custom/details/Set.h" } }
    },
    {
      "backend": "model",
      "spec": "../spec/extern/maps.spec",
      "types": {
        "PmrTransparentMap": { "header": "cocos/renderer/pipeline/custom/details/Map.h" },
        "PmrUnorderedMap": { "header": "cocos/renderer/pipeline/custom/details/Map.h" },
        "PmrFlatMap": { "header": "cocos/renderer/pipeline/custom/details/Map.h" }
      }
    },
    {
      "backend": "model",
      "spec": "../spec/extern/uniform-block.spec",
      "types": { "UniformBlock": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" } }
    },
    {
      "backend": "model",
      "spec": "../spec/extern/descriptor-set.spec",
      "types": {
        "DescriptorSetLayoutInfo": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "DescriptorSetLayout": { "header": "cocos/renderer/gfx-base/GFXDescriptorSetLayout.h" },
        "DescriptorSet": { "header": "cocos/renderer/gfx-base/GFXDescriptorSet.h" },
        "PipelineLayout": { "header": "cocos/renderer/gfx-base/GFXPipelineLayout.h" }
      }
    },
    {
      "backend": "model",
      "spec": "../spec/extern/strings.spec",
      "types": { "string": { "header": "cocos/base/std/container/string.h" } }
    },
    {
      "spec": "../spec/render/archive.spec",
      "nativeRoot": "native",
      "includeDir": "cocos/renderer/pipeline/custom",
      "prefix": "Archive",
      "typescript": "cocos/rendering/custom/archive.ts"
    },
    {
      "backend": "settings",
      "spec": "../spec/render/render-settings.spec",
      "typescript": "editor/assets/default_renderpipeline/builtin-pipeline-types.ts"
    },
    {
      "spec": "../spec/render/render-common.spec",
      "backend": "records",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/RenderCommonTypes.h",
      "forwardHeader": "cocos/renderer/pipeline/custom/RenderCommonFwd.h",
      "namesHeader": "cocos/renderer/pipeline/custom/RenderCommonNames.h",
      "serializationHeader": "cocos/renderer/pipeline/custom/RenderCommonSerialization.h",
      "jsbHeader": "cocos/renderer/pipeline/custom/RenderCommonJsb.h",
      "typescript": "cocos/rendering/custom/types.ts",
      "runtimeFiles": {
        "native/cocos/base/Pmr.h": "../runtime/cpp/Pmr.h"
      }
    },
    {
      "spec": "../spec/render/layout-graph.spec",
      "backend": "records",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/LayoutGraphTypes.h",
      "forwardHeader": "cocos/renderer/pipeline/custom/LayoutGraphFwd.h",
      "namesHeader": "cocos/renderer/pipeline/custom/LayoutGraphNames.h",
      "serializationHeader": "cocos/renderer/pipeline/custom/LayoutGraphSerialization.h",
      "typescript": "cocos/rendering/custom/layout-graph.ts",
      "runtimeFiles": {
        "native/cocos/base/GraphDFS.h": "../runtime/cpp/GraphDFS.h",
        "native/cocos/renderer/pipeline/custom/LayoutGraphPrint.h": "../runtime/cpp/LayoutGraphPrint.h",
        "native/cocos/renderer/pipeline/custom/LayoutGraphDescriptorSet.h": "../runtime/cpp/LayoutGraphDescriptorSet.h",
        "native/cocos/renderer/pipeline/custom/LayoutGraphDescriptorSet.cpp": "../runtime/cpp/LayoutGraphDescriptorSet.cpp",
        "native/cocos/renderer/pipeline/custom/LayoutGraphPrint.cpp": "../runtime/cpp/LayoutGraphPrint.cpp",
        "cocos/rendering/custom/graph-dfs.ts": "../runtime/typescript/graph-dfs.ts",
        "cocos/rendering/custom/layout-access.ts": "../runtime/typescript/layout-access.ts"
      }
    },
    {
      "spec": "../spec/extern/gfx.spec",
      "backend": "model",
      "types": {
        "Type": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "ResolveMode": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "ShaderStageFlagBit": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "MemoryAccessBit": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "ViewDimension": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "SampleType": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "Format": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" }
      }
    },
    {
      "spec": "../spec/extern/light.spec",
      "backend": "model",
      "types": {
        "Light": { "header": "cocos/scene/Light.h" }
      }
    },
    {
      "spec": "../spec/extern/reflection-probe.spec",
      "backend": "model",
      "types": {
        "ReflectionProbe": { "header": "cocos/scene/ReflectionProbe.h" }
      }
    }
  ]
}

      "typescript": "cocos/rendering/custom/layout-graph.ts",
      "runtimeFiles": {
        "native/cocos/base/GraphDFS.h": "../runtime/cpp/GraphDFS.h",
        "native/cocos/base/GraphView.h": "../runtime/cpp/GraphView.h",
        "native/cocos/renderer/pipeline/custom/LayoutGraphPrint.h": "../runtime/cpp/LayoutGraphPrint.h",
        "native/cocos/renderer/pipeline/custom/LayoutGraphDescriptorSet.h": "../runtime/cpp/LayoutGraphDescriptorSet.h",
        "native/cocos/renderer/pipeline/custom/LayoutGraphDescriptorSet.cpp": "../runtime/cpp/LayoutGraphDescriptorSet.cpp",
        "native/cocos/renderer/pipeline/custom/LayoutGraphPrint.cpp": "../runtime/cpp/LayoutGraphPrint.cpp",
        "cocos/rendering/custom/graph-dfs.ts": "../runtime/typescript/graph-dfs.ts",
        "cocos/rendering/custom/layout-access.ts": "../runtime/typescript/layout-access.ts"
      }
    },
    {
      "spec": "../spec/extern/gfx-resource.spec",
      "backend": "model",
      "types": {
        "ResourceRange": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "RenderPassInfo": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "FramebufferInfo": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "BufferInfo": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "TextureInfo": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "ShaderInfo": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "Attribute": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "CommandBuffer": { "header": "cocos/renderer/gfx-base/GFXCommandBuffer.h" },
        "Shader": { "header": "cocos/renderer/gfx-base/GFXShader.h" },
        "PipelineState": { "header": "cocos/renderer/gfx-base/GFXPipelineState.h" },
        "GFXObject": { "header": "cocos/renderer/gfx-base/GFXObject.h" },
        "InputAssembler": { "header": "cocos/renderer/gfx-base/GFXInputAssembler.h" },

{
  "outputRoot": "../build/staging/cocos4",
  "lineEnding": "crlf",
  "preamble": "preamble.txt",
  "types": "../spec/extern/types.json",
  "modules": [
    {
      "spec": "../spec/render/archive.spec",
      "projection": "../spec/render/archive.json",
      "nativeRoot": "native",
      "includeDir": "cocos/renderer/pipeline/custom",
      "prefix": "Archive",
      "typescript": "cocos/rendering/custom/archive.ts"
    },
    {
      "backend": "settings",
      "spec": "../spec/render/render-settings.spec",
      "projection": "../spec/render/render-settings.json",
      "typescript": "editor/assets/default_renderpipeline/builtin-pipeline-types.ts"
    },
    {
      "spec": "../spec/render/render-common.spec",
      "backend": "records",
      "projection": "../spec/render/render-common.json",
      "header": "native/cocos/renderer/pipeline/custom/RenderCommonTypes.h",
      "typescript": "cocos/rendering/custom/types.ts"
    },
    {
      "spec": "../spec/extern/gfx.spec",
      "backend": "model",
      "types": {
        "ResolveMode": { "header": "cocos/renderer/gfx-base/GFXDef-common.h", "ts": "ResolveMode", "tsModule": "cocos/gfx" }
      }
    },
    {
      "spec": "../spec/extern/light.spec",
      "backend": "model",
      "types": {
        "Light": { "header": "cocos/scene/Light.h", "ts": "Light", "tsModule": "cocos/render-scene/scene" }
      }
    },
    {
      "spec": "../spec/extern/reflection-probe.spec",
      "backend": "model",
      "types": {
        "ReflectionProbe": { "header": "cocos/scene/ReflectionProbe.h", "ts": "ReflectionProbe", "tsModule": "cocos/render-scene/scene/reflection-probe" }
      }
    }
  ]
}

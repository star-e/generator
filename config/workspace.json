{
  "outputRoot": "../build/staging/cocos4",
  "lineEnding": "crlf",
  "preamble": "preamble.txt",
  "types": "../spec/extern/types.json",
  "modules": [
    {
      "spec": "../spec/render/archive.spec",
      "projection": "../spec/render/archive.json",
      "nativeRoot": "native",
      "includeDir": "cocos/renderer/pipeline/custom",
      "prefix": "Archive",
      "typescript": "cocos/rendering/custom/archive.ts"
    },
    {
      "backend": "settings",
      "spec": "../spec/render/render-settings.spec",
      "projection": "../spec/render/render-settings.json",
      "typescript": "editor/assets/default_renderpipeline/builtin-pipeline-types.ts"
    },
    {
      "spec": "../spec/render/render-common.spec",
      "backend": "model"
    },
    {
      "spec": "../spec/extern/light.spec",
      "backend": "model"
    },
    {
      "spec": "../spec/extern/reflection-probe.spec",
      "backend": "model"
    }
  ]
}

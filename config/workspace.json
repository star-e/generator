{
  "outputRoot": "../build/staging/cocos4",
  "lineEnding": "crlf",
  "preamble": "preamble.txt",
  "types": "../spec/extern/types.json",
  "modules": [
    { "backend": "model", "spec": "../spec/extern/types.spec" },
    {
      "backend": "model",
      "spec": "../spec/extern/containers.spec",
      "types": {
        "unordered_map": { "header": "cocos/base/std/container/unordered_map.h" },
        "map": { "header": "cocos/base/std/container/map.h" },
        "string": { "header": "cocos/base/std/container/string.h" },
        "vector": { "header": "cocos/base/std/container/vector.h" }
      }
    },
    {
      "backend": "model",
      "spec": "../spec/extern/pmr-containers.spec",
      "types": {
        "map": { "header": "cocos/base/std/container/map.h" },
        "unordered_map": { "header": "cocos/base/std/container/unordered_map.h" },
        "vector": { "header": "cocos/base/std/container/vector.h" }
      }
    },
    {
      "backend": "model",
      "spec": "../spec/extern/sets.spec",
      "types": {
        "PmrFlatSet": { "header": "cocos/renderer/pipeline/custom/details/Set.h" },
        "PmrTransparentSet": { "header": "cocos/renderer/pipeline/custom/details/Set.h" }
      }
    },
    {
      "backend": "model",
      "spec": "../spec/extern/maps.spec",
      "types": {
        "PmrTransparentMap": { "header": "cocos/renderer/pipeline/custom/details/Map.h" },
        "PmrUnorderedMap": { "header": "cocos/renderer/pipeline/custom/details/Map.h" },
        "PmrUnorderedStringMap": { "header": "cocos/renderer/pipeline/custom/details/Map.h" },
        "PmrFlatMap": { "header": "cocos/renderer/pipeline/custom/details/Map.h" }
      }
    },
    {
      "backend": "model",
      "spec": "../spec/extern/uniform-block.spec",
      "types": { "UniformBlock": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" } }
    },
    {
      "backend": "model",
      "spec": "../spec/extern/descriptor-set.spec",
      "types": {
        "DescriptorSetLayoutInfo": { "header": "cocos/renderer/gfx-base/GFXDef-common.h" },
        "DescriptorSetLayout": { "header": "cocos/renderer/gfx-base/GFXDescriptorSetLayout.h" },

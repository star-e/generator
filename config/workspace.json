{
  "outputRoot": "../build/staging/cocos4",
  "lineEnding": "crlf",
  "preamble": "preamble.txt",
  "types": "../spec/extern/types.json",
  "modules": [
    { "backend": "model", "spec": "../spec/extern/types.spec" },
    { "backend": "model", "spec": "../spec/extern/containers.spec" },
    { "backend": "model", "spec": "../spec/extern/pmr-containers.spec" },
    { "backend": "model", "spec": "../spec/extern/sets.spec" },
    { "backend": "model", "spec": "../spec/extern/maps.spec" },
    { "backend": "model", "spec": "../spec/extern/uniform-block.spec" },
    { "backend": "model", "spec": "../spec/extern/descriptor-set.spec" },
    { "backend": "model", "spec": "../spec/extern/strings.spec" },
    {
      "spec": "../spec/render/archive.spec",
      "nativeRoot": "native",
      "includeDir": "cocos/renderer/pipeline/custom",
      "prefix": "Archive",
      "typescript": "cocos/rendering/custom/archive.ts"
    },
    {
      "backend": "settings",
      "spec": "../spec/render/render-settings.spec",
      "typescript": "editor/assets/default_renderpipeline/builtin-pipeline-types.ts"
    },
    {
      "spec": "../spec/render/render-common.spec",
      "backend": "records",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/RenderCommonTypes.h",
      "forwardHeader": "cocos/renderer/pipeline/custom/RenderCommonFwd.h",
      "namesHeader": "cocos/renderer/pipeline/custom/RenderCommonNames.h",
      "serializationHeader": "cocos/renderer/pipeline/custom/RenderCommonSerialization.h",
      "jsbHeader": "cocos/renderer/pipeline/custom/RenderCommonJsb.h",
      "typescript": "cocos/rendering/custom/types.ts",
      "runtimeFiles": {
        "native/cocos/base/Pmr.h": "../runtime/cpp/Pmr.h"
      }
    },
    {
      "spec": "../spec/render/graph-tags.spec",
      "backend": "records",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/GraphTags.h",
      "namesHeader": "cocos/renderer/pipeline/custom/GraphTagNames.h"
    },
    {
      "spec": "../spec/render/layout-graph.spec",
      "backend": "records",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/LayoutGraphTypes.h",
      "forwardHeader": "cocos/renderer/pipeline/custom/LayoutGraphFwd.h",
      "namesHeader": "cocos/renderer/pipeline/custom/LayoutGraphNames.h",
      "serializationHeader": "cocos/renderer/pipeline/custom/LayoutGraphSerialization.h",
      "typescript": "cocos/rendering/custom/layout-graph.ts",
      "runtimeFiles": {
        "native/cocos/base/GraphDFS.h": "../runtime/cpp/GraphDFS.h",
        "native/cocos/base/GraphView.h": "../runtime/cpp/GraphView.h",
        "native/cocos/renderer/pipeline/custom/LayoutGraphPrint.h": "../runtime/cpp/LayoutGraphPrint.h",
        "native/cocos/renderer/pipeline/custom/LayoutGraphDescriptorSet.h": "../runtime/cpp/LayoutGraphDescriptorSet.h",
        "native/cocos/renderer/pipeline/custom/LayoutGraphDescriptorSet.cpp": "../runtime/cpp/LayoutGraphDescriptorSet.cpp",
        "native/cocos/renderer/pipeline/custom/LayoutGraphPrint.cpp": "../runtime/cpp/LayoutGraphPrint.cpp",
        "cocos/rendering/custom/graph-dfs.ts": "../runtime/typescript/graph-dfs.ts",
        "cocos/rendering/custom/layout-access.ts": "../runtime/typescript/layout-access.ts"
      }
    },
    { "backend": "model", "spec": "../spec/extern/gfx-resource.spec" },
    { "backend": "model", "spec": "../spec/extern/scene.spec" },
    { "backend": "model", "spec": "../spec/extern/render-window.spec" },
    {
      "spec": "../spec/render/render-graph.spec",
      "backend": "records",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/RenderGraphTypes.h",
      "forwardHeader": "cocos/renderer/pipeline/custom/RenderGraphFwd.h",
      "typescript": "cocos/rendering/custom/render-graph.ts",
      "runtimeFiles": {
        "native/cocos/base/GraphEdges.h": "../runtime/cpp/GraphEdges.h"
      }
    },
    { "backend": "model", "spec": "../spec/extern/gfx.spec" },
    { "backend": "model", "spec": "../spec/extern/light.spec" },
    { "backend": "model", "spec": "../spec/extern/reflection-probe.spec" },
    { "backend": "model", "spec": "../spec/extern/pipeline-externals.spec" },
    {
      "backend": "records",
      "spec": "../spec/render/pipeline-capabilities.spec",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/PipelineCapabilities.h",
      "typescript": "cocos/rendering/custom/pipeline-capabilities.ts"
    },
    {
      "backend": "records",
      "spec": "../spec/render/render-interface.spec",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/RenderInterfaceTypes.h",
      "emitEmptySource": true,
      "forwardHeader": "cocos/renderer/pipeline/custom/RenderInterfaceFwd.h",
      "forwardIncludes": ["cocos/renderer/pipeline/custom/RenderCommonFwd.h", "cocos/renderer/pipeline/custom/PipelineCapabilities.h"]
    },
    {
      "backend": "records",
      "spec": "../spec/render/private-interface.spec",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/PrivateTypes.h",
      "emitEmptySource": true,
      "typescript": "cocos/rendering/custom/private.ts",
      "forwardHeader": "cocos/renderer/pipeline/custom/PrivateFwd.h",
      "forwardIncludes": ["cocos/renderer/pipeline/custom/RenderInterfaceFwd.h"]
    },
    {
      "backend": "records",
      "spec": "../spec/render/customization.spec",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/CustomTypes.h",
      "emitEmptySource": true,
      "forwardHeader": "cocos/renderer/pipeline/custom/CustomFwd.h",
      "forwardIncludes": ["cocos/renderer/pipeline/custom/RenderGraphFwd.h"]
    },
    {
      "backend": "records",
      "spec": "../spec/render/fg-dispatcher.spec",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/FGDispatcherRecords.h"
    },
    {
      "backend": "records",
      "spec": "../spec/render/private-types.spec",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/NativeTypes.h",
      "forwardHeader": "cocos/renderer/pipeline/custom/NativeFwd.h",
      "forwardIncludes": ["cocos/renderer/pipeline/custom/LayoutGraphFwd.h", "cocos/renderer/pipeline/custom/PrivateFwd.h"],
      "typescript": "cocos/rendering/custom/web-types.ts"
    },
    {
      "backend": "records",
      "spec": "../spec/render/native-pipeline.spec",
      "nativeRoot": "native",
      "header": "cocos/renderer/pipeline/custom/NativePipelineRecords.h",
      "forwardHeader": "cocos/renderer/pipeline/custom/NativePipelineRecordsFwd.h",
      "runtimeFiles": { "native/cocos/renderer/pipeline/custom/Array4.h": "../runtime/cpp/Array4.h" }
    }
  ]
}

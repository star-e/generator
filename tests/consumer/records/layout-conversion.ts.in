function assert (ok: boolean): void { if (!ok) throw new Error('Invalid editor layout'); }
function error (message: string): never { throw new Error(message); }

interface Device {
    createDescriptorSetLayout(info: Readonly<DescriptorSetLayoutInfo>): DescriptorSetLayout;
    createDescriptorSet(info: Readonly<DescriptorSetInfo>): DescriptorSet;
}


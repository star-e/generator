import { ED, OutEI } from './graph';
import type { AddressableGraph, ReferenceGraph } from './graph';
import type { InputArchive } from './archive';
import { Descriptor, DescriptorBlock, DescriptorBlockIndex, DescriptorDB, DescriptorGroupBlockIndex,
    LayoutGraph, LayoutGraphValue, RenderPassType, RenderPhase } from './layout-graph';
import { FlatComponents, HierarchyOnly, TinyNames, Toggles, TogglesValue } from './shift-probe';
import { UpdateFrequency } from './types';

function assert (ok: boolean, message = 'Editor layout assertion failed'): void {
    if (!ok) throw new Error(message);
}

function error (message: string): never { throw new Error(message); }

function checkChildren (g: Pick<ReferenceGraph, 'children' | 'child' | 'numChildren' | 'parent' | 'reference'>, parent: number, expected: number[]): void {
    const iterator = g.children(parent);
    const edges = [...iterator];
    assert(iterator instanceof OutEI && edges.length === expected.length && g.numChildren(parent) === expected.length,
        'Direct child count');
    assert(edges.every((edge, i) => edge instanceof ED && edge.source === parent && edge.target === expected[i] &&
        g.child(edge) === expected[i] && g.parent(edge) === parent && g.reference(parent, expected[i])),
        'Child edge endpoints and insertion order');
}

export function checkNativePaths (samples: InputArchive): void {
    const g = new LayoutGraph();
    const view: AddressableGraph = g;
    const count = samples.n();
    const paths: [string, number][] = [];
    for (let i = 0; i < count; ++i) {
        const parent = samples.n();
        const name = samples.s();
        const v = samples.b()
            ? g.addVertex(LayoutGraphValue.RenderPhase, new RenderPhase(), name, new DescriptorDB(), parent)
            : g.addVertex(LayoutGraphValue.RenderStage, samples.n() as RenderPassType, name, new DescriptorDB(), parent);
        assert(v === i, 'Native vertex order');
        paths.push([samples.s(), samples.n()]);
    }
    paths.forEach(([path, first], v) => {
        assert(view.path(v) === path && view.locate(path) === first, 'Native absolute path ' + path);
    });
    const queries = samples.n();
    for (let i = 0; i < queries; ++i) {
        const start = samples.n();
        const path = samples.s();
        const expected = samples.n();
        assert(view.locateRelative(path, start) === expected, 'Native relative path ' + path + ' from ' + start);
        if (start === g.N) assert(view.locateRelative(path) === expected && view.locate(path) === expected, 'Root lookup');
    }
    assert(view.path(g.N) === '', 'Pseudo-root path');
    for (const v of [count, -1, 0.5, NaN]) {
        let rejected = false;
        try { view.path(v); } catch (e) { rejected = e instanceof RangeError; }
        assert(rejected && view.locateRelative('.', v) === g.N, 'Invalid vertex ' + v);
    }
}

class EditorFixture {
    readonly lg = new LayoutGraph();
@editorMethods@
    private updatePasses (): number {
        const lg = this.lg;
@updatePasses@
        return 0;
    }

    run (): void {
        const lg = this.lg;
        const stage = LayoutGraphValue.RenderStage;
        const phase = LayoutGraphValue.RenderPhase;
        const root = this.getPassID('main', RenderPassType.RENDER_PASS);
        const sub = this.getSubpassID('deferred', root);
        const shadow = this.getPhaseID('shadow', sub);
        const other = this.getPhaseID('shadow', root);
        assert(root === this.getPassID('main', RenderPassType.RENDER_PASS) &&
            sub === this.getSubpassID('deferred', root) && shadow === this.getPhaseID('shadow', sub), 'Vertex reuse');
        assert(shadow !== other && [...lg.v()].length === 4 && lg.nv() === 4, 'Scoped phase names');
        assert(lg.N === 0xFFFFFFFF && lg.getParent(root) === lg.N && lg.getParent(lg.N) === lg.N &&
            lg.getParent(shadow) === sub && lg.getParent(other) === root, 'Parent lookup');
        assert(lg.locateChild(lg.N, 'shadow') === lg.N && lg.locateChild(lg.nv(), 'shadow') === lg.N, 'Missing child');
        assert(lg.getName(shadow) === 'shadow' && lg.w(shadow) === phase && lg.w(sub) === stage, 'Vertex kind and name');
        const passType: RenderPassType = lg.value(stage, sub);
        assert(passType === RenderPassType.RENDER_SUBPASS, 'Stage payload');
        lg.value(phase, shadow).shaders.add('shadow-caster');
        assert(lg.value(phase, this.getPhaseID('shadow', sub)).shaders.has('shadow-caster') &&
            !lg.value(phase, other).shaders.has('shadow-caster'), 'Independent phase payloads');

        const db = new DescriptorDB();
        const payload = new RenderPhase();
        const extra = lg.addVertex(phase, payload, 'shadow', db, sub);
        assert(lg.getDescriptors(extra) === db && lg.value(phase, extra) === payload, 'Supplied objects');
        assert(lg.locateChild(sub, 'shadow') === shadow, 'First matching child');
        const forward = this.getPassID('forward', RenderPassType.SINGLE_RENDER_PASS);
        const forwardShadow = this.getPhaseID('shadow', forward);
        assert(lg.locate(lg.path(shadow)) === shadow && lg.locate(lg.path(forwardShadow)) === forwardShadow &&
            lg.locateRelative('../shadow', forwardShadow) === forwardShadow, 'Scoped phase paths');
        checkChildren(lg, root, [sub, other]);
        checkChildren(lg, sub, [shadow, extra]);
        checkChildren(lg, forward, [forwardShadow]);
        checkChildren(lg, shadow, []);
        assert(lg.j<RenderPhase>(extra) === payload, 'Phase payload identity');

        const blockKey = JSON.stringify(new DescriptorBlockIndex(UpdateFrequency.PER_PASS));
        const groupKey = JSON.stringify(new DescriptorGroupBlockIndex(UpdateFrequency.PER_PASS));
        for (const pass of [sub, forward]) {
            const block = new DescriptorBlock();
            block.capacity = block.count = 1;
            block.descriptors.set(lg.getName(pass), new Descriptor());
            lg.getDescriptors(pass).blocks.set(blockKey, block);
            lg.getDescriptors(pass).groupBlocks.set(groupKey, block);
        }
        assert(this.updatePasses() === 0, 'Editor pass traversal');
        for (const [pass, child] of [[sub, shadow], [sub, extra], [forward, forwardShadow]]) {
            const name = lg.getName(pass);
            const expected = lg.getDescriptors(pass).blocks.get(blockKey)!.descriptors.get(name)!;
            const childDB = lg.getDescriptors(child);
            assert(childDB.blocks.get(blockKey)!.descriptors.get(name) === expected &&
                childDB.groupBlocks.get(groupKey)!.descriptors.get(name) === expected, 'Descriptors from the direct parent');
        }
        assert(lg.getDescriptors(other).blocks.size === 0, 'Render pass must be skipped');
        let mismatched = false;
        try { lg.value(phase, root); } catch { mismatched = true; }
        assert(mismatched, 'Wrong payload kind');
        const count = lg.nv();
        let invalidParent = false;
        try { lg.addVertex(phase, payload, 'invalid', db, count); } catch (e) { invalidParent = e instanceof RangeError; }
        assert(invalidParent && lg.nv() === count, 'Invalid parent left a partial vertex');
    }
}

// Kept out of the runtime path so tsc independently checks the rejected calls.
function checkTypes (lg: LayoutGraph, db: DescriptorDB): void {
    // @ts-expect-error A stage takes a RenderPassType.
    lg.addVertex(LayoutGraphValue.RenderStage, new RenderPhase(), 'bad', db);
    // @ts-expect-error The value returned for a stage has no shaders.
    lg.value(LayoutGraphValue.RenderStage, 0).shaders;
    // @ts-expect-error DescriptorDB is a component, not a polymorphic payload.
    lg.j<DescriptorDB>(0);
    // @ts-expect-error Named lookup requires parent_graph.
    new HierarchyOnly().locateChild(0, 'name');
    // @ts-expect-error Flat graphs have no child edges.
    new FlatComponents().children(0);
}

new EditorFixture().run();

const tree = new HierarchyOnly();
const root = tree.addVertex(10);
const independent = tree.addVertex(20);
const first = tree.addVertex(30, root);
const leaf = tree.addVertex(40, first);
const last = tree.addVertex(50, root);
checkChildren(tree, root, [first, last]);
checkChildren(tree, first, [leaf]);
checkChildren(tree, leaf, []);
checkChildren(tree, independent, []);

const flat = new FlatComponents();
const db = new DescriptorDB();
const index = flat.addVertex(db, 'flat', 42);
assert(flat.getDescriptors(index) === db && flat.getCount(index) === 42 && flat.getName(index) === 'flat', 'Component order');
const toggles = new Toggles();
const toggle = toggles.addVertex(TogglesValue.ComputeTag, false);
assert(toggles.w(toggle) === TogglesValue.ComputeTag && toggles.value(TogglesValue.ComputeTag, toggle) === false,
    'Distinct tags sharing a payload type');
const nested = new LayoutGraph();
const layout = toggles.addVertex(TogglesValue.Layout, nested);
assert(toggles.value(TogglesValue.Layout, layout) === nested, 'Imported graph payload');
const tiny = new TinyNames();
for (let i = 0; i < 255; ++i) assert(tiny.addVertex('v') === i);
let full = false;
try { tiny.addVertex('overflow'); } catch (e) { full = e instanceof RangeError; }
assert(full && tiny.nv() === tiny.N, 'Narrow vertex descriptor');

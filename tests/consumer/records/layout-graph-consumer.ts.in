import type { InputArchive } from './archive';
import { Descriptor, DescriptorBlock, DescriptorBlockIndex, DescriptorDB, DescriptorGroupBlockIndex,
    EffectData, LayoutGraph, LayoutGraphData, LayoutGraphDataValue, LayoutGraphValue, RenderPassType,
    RenderPhase, RenderPhaseData, RenderStageData, getLayoutGraphValueName, getLayoutGraphDataValueName } from './layout-graph';
import { convertDescriptorBlock, getVisibilityName, indent, LayoutGraphBuilder2, unindent, VectorGraphColorMap } from './layout-graph-conversion';

@layoutGraphPrintVisitor@

function assert (ok: boolean, message = 'Editor layout assertion failed'): void {
    if (!ok) throw new Error(message);
}

function error (message: string): never { throw new Error(message); }

class ProgramGroup {}
class ProgramLibraryFixture {
    readonly layoutGraph: LayoutGraphData;
    readonly phases = new Map<number, ProgramGroup>();
@programLibraryConstructor@
}

function checkLayoutGraphData (): void {
    const g = new LayoutGraphData();
    const builder = new LayoutGraphBuilder2(g);
    const root = builder.addRenderStage('main', g.N);
    const phase = builder.addRenderPhase('shadow', root);
    builder.addShader('caster', phase);
    const programs = new ProgramLibraryFixture(g);
    assert(programs.phases.size === 1 && programs.phases.get(phase) instanceof ProgramGroup, 'Web program phase selection');
    assert(g.getUpdate(root) === UpdateFrequency.PER_PASS && g.getUpdate(phase) === UpdateFrequency.PER_PHASE);
    g.setUpdate(phase, UpdateFrequency.PER_BATCH);
    assert(g.getUpdate(phase) === UpdateFrequency.PER_BATCH && g.getUpdate(root) === UpdateFrequency.PER_PASS);
    g.setUpdate(phase, UpdateFrequency.PER_PHASE);
    assert(getLayoutGraphValueName(LayoutGraphValue.RenderStage) === 'RenderStage' &&
        getLayoutGraphDataValueName(g.w(phase)) === 'RenderPhase');
    const phaseData = g.value(LayoutGraphDataValue.RenderPhase, phase);
    assert(g.locate('/main/shadow') === phase && phaseData.shaderIndex.get('caster') === 0 && phaseData.shaderPrograms.length === 1);
    const poly: PolymorphicGraph = g;
    assert(poly.h(LayoutGraphDataValue.RenderStage, root) && !poly.h(LayoutGraphDataValue.RenderStage, phase));
    assert(poly.object(phase) === phaseData && g.object(root) === g.j<RenderStageData>(root));
    const visitor = {
        renderStage(value: RenderStageData) { return value.descriptorVisibility; },
        renderPhase(value: RenderPhaseData) { return value.shaderPrograms; },
    };
    assert(g.visitVertex(visitor, root) === g.j<RenderStageData>(root).descriptorVisibility);
    assert(g.visitVertex(visitor, phase) === phaseData.shaderPrograms);

    const { valueNames, shaderLayoutIndex, attributeIndex, constantIndex, effects } = g;
    assert(shaderLayoutIndex.get('caster') === phase);
    valueNames.push('camera');
    attributeIndex.set('camera', 9);
    constantIndex.set('ambient', 7);
    effects.set('lit', new EffectData());
    g.constantMacros = 'USE_SHADOWS';
    builder.clear();
    assert(g.nv() === 0 && g.v().next().done === true && g.locateChild(g.N, 'main') === g.N);
    assert(g.valueNames === valueNames && valueNames.length === 0 && g.constantMacros === '');
    assert(g.shaderLayoutIndex === shaderLayoutIndex && g.attributeIndex === attributeIndex && g.constantIndex === constantIndex && g.effects === effects);
    assert(shaderLayoutIndex.size === 0 && attributeIndex.size === 0 && constantIndex.size === 0 && effects.size === 0);
    builder.clear();
    assert(builder.addRenderStage('next', g.N) === 0 && g.locate('/main') === g.N && g.locate('/next') === 0);
}

function checkChildren (g: BidirectionalGraph & AdjacencyGraph & EdgeListGraph & ReferenceGraph, parent: number, expected: number[]): void {
    const iterator = g.children(parent);
    const edges = [...iterator];
    assert(iterator instanceof OutEI && edges.length === expected.length && g.numChildren(parent) === expected.length,
        'Direct child count');
    assert(edges.every((edge, i) => edge instanceof ED && edge.source === parent && edge.target === expected[i] &&
        g.child(edge) === expected[i] && g.parent(edge) === parent && g.reference(parent, expected[i])),
        'Child edge endpoints and insertion order');
    const outgoing = [...g.oe(parent)];
    const adjacent = [...g.adj(parent)];
    assert(adjacent.length === expected.length && adjacent.every((v, i) => v === expected[i]), 'Adjacent vertex order');
    const incoming = [...g.ie(parent)];
    assert(incoming.length === g.id(parent) && g.d(parent) === expected.length + incoming.length &&
        (g.getParent(parent) === g.N ? incoming.length === 0 : incoming.length === 1 &&
            g.source(incoming[0]) === g.getParent(parent) && g.target(incoming[0]) === parent), 'Incoming edges');
    assert(g.od(parent) === expected.length && outgoing.length === expected.length &&
        outgoing.every((edge, i) => g.source(edge) === parent && g.target(edge) === expected[i] &&
            g.edge(parent, expected[i]) && !g.edge(expected[i], parent)), 'Shared out-edges');
}

export function checkNativePaths (samples: InputArchive): void {
    const g = new LayoutGraph();
    const view: AddressableGraph = g;
    const count = samples.n();
    const paths: [string, number][] = [];
    for (let i = 0; i < count; ++i) {
        const parent = samples.n();
        const name = samples.s();
        const v = samples.b()
            ? g.addVertex(LayoutGraphValue.RenderPhase, new RenderPhase(), name, new DescriptorDB(), parent)
            : g.addVertex(LayoutGraphValue.RenderStage, samples.n() as RenderPassType, name, new DescriptorDB(), parent);
        assert(v === i, 'Native vertex order');
        paths.push([samples.s(), samples.n()]);
    }
    paths.forEach(([path, first], v) => {
        assert(view.path(v) === path && view.locate(path) === first, 'Native absolute path ' + path);
    });
    const queries = samples.n();
    for (let i = 0; i < queries; ++i) {
        const start = samples.n();
        const path = samples.s();
        const expected = samples.n();
        assert(view.locateRelative(path, start) === expected, 'Native relative path ' + path + ' from ' + start);
        if (start === g.N) assert(view.locateRelative(path) === expected && view.locate(path) === expected, 'Root lookup');
    }
    assert(view.path(g.N) === '', 'Pseudo-root path');
    for (const v of [count, -1, 0.5, NaN]) {
        let rejected = false;
        try { view.path(v); } catch (e) { rejected = e instanceof RangeError; }
        assert(rejected && view.locateRelative('.', v) === g.N, 'Invalid vertex ' + v);
    }
}

class EditorFixture {
    readonly lg = new LayoutGraph();
@editorPrint@
@editorMethods@
    private updatePasses (): number {
        const lg = this.lg;
@updatePasses@
        return 0;
    }

    run (): void {
        const lg = this.lg;
        const stage = LayoutGraphValue.RenderStage;
        const phase = LayoutGraphValue.RenderPhase;
        assert(this.print() === '', 'Empty editor output');
        const root = this.getPassID('main', RenderPassType.RENDER_PASS);
        const sub = this.getSubpassID('deferred', root);
        const shadow = this.getPhaseID('shadow', sub);
        const other = this.getPhaseID('shadow', root);
        assert(this.print() === [
            '"main": RenderStage {',
            '    "deferred": RenderStage {',
            '        "shadow": RenderPhase {',
            '        }',
            '    }',
            '    "shadow": RenderPhase {',
            '    }',
            '}',
            '',
        ].join('\n'), 'Editor indentation, sibling order and closing braces');
        assert(root === this.getPassID('main', RenderPassType.RENDER_PASS) &&
            sub === this.getSubpassID('deferred', root) && shadow === this.getPhaseID('shadow', sub), 'Vertex reuse');
        assert(shadow !== other && [...lg.v()].length === 4 && lg.nv() === 4, 'Scoped phase names');
        assert(lg.N === 0xFFFFFFFF && lg.getParent(root) === lg.N && lg.getParent(lg.N) === lg.N &&
            lg.getParent(shadow) === sub && lg.getParent(other) === root, 'Parent lookup');
        assert(lg.locateChild(lg.N, 'shadow') === lg.N && lg.locateChild(lg.nv(), 'shadow') === lg.N, 'Missing child');
        assert(lg.getName(shadow) === 'shadow' && lg.w(shadow) === phase && lg.w(sub) === stage, 'Vertex kind and name');
        const passType: RenderPassType = lg.value(stage, sub);
        assert(passType === RenderPassType.RENDER_SUBPASS, 'Stage payload');
        lg.value(phase, shadow).shaders.add('shadow-caster');
        assert(lg.value(phase, this.getPhaseID('shadow', sub)).shaders.has('shadow-caster') &&
            !lg.value(phase, other).shaders.has('shadow-caster'), 'Independent phase payloads');

        const db = new DescriptorDB();
        const payload = new RenderPhase();
        const extra = lg.addVertex(phase, payload, 'shadow', db, sub);
        assert(lg.getDescriptors(extra) === db && lg.value(phase, extra) === payload, 'Supplied objects');
        assert(lg.locateChild(sub, 'shadow') === shadow, 'First matching child');
        const forward = this.getPassID('forward', RenderPassType.SINGLE_RENDER_PASS);
        const forwardShadow = this.getPhaseID('shadow', forward);
        assert(lg.locate(lg.path(shadow)) === shadow && lg.locate(lg.path(forwardShadow)) === forwardShadow &&
            lg.locateRelative('../shadow', forwardShadow) === forwardShadow, 'Scoped phase paths');
        checkChildren(lg, root, [sub, other]);
        checkChildren(lg, sub, [shadow, extra]);
        checkChildren(lg, forward, [forwardShadow]);
        checkChildren(lg, shadow, []);
        assert(lg.j<RenderPhase>(extra) === payload, 'Phase payload identity');

        const blockKey = JSON.stringify(new DescriptorBlockIndex(UpdateFrequency.PER_PASS));
        const groupKey = JSON.stringify(new DescriptorGroupBlockIndex(UpdateFrequency.PER_PASS));
        for (const pass of [sub, forward]) {
            const block = new DescriptorBlock();
            block.capacity = block.count = 1;
            block.descriptors.set(lg.getName(pass), new Descriptor());
            lg.getDescriptors(pass).blocks.set(blockKey, block);
            lg.getDescriptors(pass).groupBlocks.set(groupKey, block);
        }
        assert(this.updatePasses() === 0, 'Editor pass traversal');
        const referencePrint = new LayoutGraphPrintVisitor();
        engineSearch(lg, referencePrint, new VectorGraphColorMap(lg.nv()));
        assert(referencePrint.oss.indexOf('descriptors: [deferred]') >= 0 &&
            referencePrint.oss.indexOf('"forward": RenderStage') >= 0 &&
            this.print() === referencePrint.oss, 'Full editor output with descriptors and multiple roots');
        for (const [pass, child] of [[sub, shadow], [sub, extra], [forward, forwardShadow]]) {
            const name = lg.getName(pass);
            const expected = lg.getDescriptors(pass).blocks.get(blockKey)!.descriptors.get(name)!;
            const childDB = lg.getDescriptors(child);
            assert(childDB.blocks.get(blockKey)!.descriptors.get(name) === expected &&
                childDB.groupBlocks.get(groupKey)!.descriptors.get(name) === expected, 'Descriptors from the direct parent');
        }
        assert(lg.getDescriptors(other).blocks.size === 0, 'Render pass must be skipped');
        let mismatched = false;
        try { lg.value(phase, root); } catch { mismatched = true; }
        assert(mismatched, 'Wrong payload kind');
        const count = lg.nv();
        let invalidParent = false;
        try { lg.addVertex(phase, payload, 'invalid', db, count); } catch (e) { invalidParent = e instanceof RangeError; }
        assert(invalidParent && lg.nv() === count, 'Invalid parent left a partial vertex');
    }
}

// Kept out of the runtime path so tsc independently checks the rejected calls.
function checkTypes (lg: LayoutGraph, db: DescriptorDB): void {
    // @ts-expect-error A stage takes a RenderPassType.
    lg.addVertex(LayoutGraphValue.RenderStage, new RenderPhase(), 'bad', db);
    // @ts-expect-error The value returned for a stage has no shaders.
    lg.value(LayoutGraphValue.RenderStage, 0).shaders;
    // @ts-expect-error DescriptorDB is a component, not a polymorphic payload.
    lg.j<DescriptorDB>(0);
    // @ts-expect-error The visitor must handle both stage and phase.
    lg.visitVertex({ renderStage: () => 0 }, 0);
    // @ts-expect-error Only polymorphic graphs expose a visitor.
    new FlatComponents().visitVertex({}, 0);
    // @ts-expect-error Named lookup requires parent_graph.
    new HierarchyOnly().locateChild(0, 'name');
    // @ts-expect-error Flat graphs have no child edges.
    new FlatComponents().children(0);
    // @ts-expect-error Flat graphs have no shared out-edges.
    new FlatComponents().oe(0);
}

new EditorFixture().run();
checkLayoutGraphData();

const tree = new HierarchyOnly();
const root = tree.addVertex(10);
const independent = tree.addVertex(20);
const first = tree.addVertex(30, root);
const leaf = tree.addVertex(40, first);
const last = tree.addVertex(50, root);
checkChildren(tree, root, [first, last]);
checkChildren(tree, first, [leaf]);
checkChildren(tree, leaf, []);
checkChildren(tree, independent, []);

const flat = new FlatComponents();
const db = new DescriptorDB();
const index = flat.addVertex(db, 'flat', 42);
flat.setCount(index, 43);
assert(flat.getCount(index) === 43);
flat.setCount(index, 42);
assert(flat.getDescriptors(index) === db && flat.getCount(index) === 42 && flat.getName(index) === 'flat', 'Component order');
let invalidWrite = false;
try { flat.setCount(index + 1, 99); } catch (e) { invalidWrite = e instanceof RangeError; }
assert(invalidWrite && flat.nv() === 1, 'Invalid setter must not extend a component column');
flat.version = 9;
flat.clear();
assert(flat.nv() === 0 && flat.version === 1, 'Flat graph scalar default');
assert(flat.addVertex(db, 'new', 0) === 0 && flat.getName(0) === 'new' && flat.getCount(0) === 0);
const toggles = new Toggles();
const toggle = toggles.addVertex(TogglesValue.ComputeTag, false);
assert(toggles.w(toggle) === TogglesValue.ComputeTag && toggles.value(TogglesValue.ComputeTag, toggle) === false,
    'Distinct tags sharing a payload type');
const count = toggles.addVertex(TogglesValue.Count, false);
const visitToggle = { count: () => 'count', computeTag: () => 'compute', layout: () => 'layout' };
assert(toggles.visitVertex(visitToggle, toggle) === 'compute' && toggles.visitVertex(visitToggle, count) === 'count',
    'Visit by tag when two payload types are identical');
const nested = new LayoutGraph();
const layout = toggles.addVertex(TogglesValue.Layout, nested);
assert(toggles.value(TogglesValue.Layout, layout) === nested, 'Imported graph payload');
const tiny = new TinyNames();
for (let i = 0; i < 255; ++i) assert(tiny.addVertex('v') === i);
let full = false;
try { tiny.addVertex('overflow'); } catch (e) { full = e instanceof RangeError; }
assert(full && tiny.nv() === tiny.N, 'Narrow vertex descriptor');
const lastEdge = tiny.addEdge(0, tiny.N - 1);
assert(lastEdge !== null && tiny.od(0) === 1 && !('ie' in tiny), 'Outgoing incidence');
tiny.removeEdges(0, tiny.N - 1);
assert(tiny.ne() === 0, 'Outgoing incidence removal');

const indexed = new IndexedNames();
indexed.addVertex(IndexedNamesValue.Count, 17, 23, '');
// Fail the final link after the payload, components and name index have been written.
const children = indexed['_children'][0];
const linkFailure = new Error('injected child append failure');
Object.defineProperty(children, 'push', { configurable: true, value () { throw linkFailure; } });
let rolledBack = false;
try { indexed.addVertex(IndexedNamesValue.Count, 31, 37, 'child', 0); }
catch (e) { rolledBack = e === linkFailure; }
finally { Reflect.deleteProperty(children, 'push'); }
assert(rolledBack && !indexed.contains('child') && indexed.numChildren(0) === 0);
assert([indexed['_children'], indexed['_parents'], indexed['_kinds'], indexed['_indices'],
    indexed['_components'].Name, indexed['_components'].Count, indexed['_objects'][IndexedNamesValue.Count]]
    .every(column => column.length === 1), 'Failed insertion must restore every column');
assert(indexed.addVertex(IndexedNamesValue.Count, 19, 29, 'child', 0) === 1);
const writer = new BinaryOutputArchive();
saveIndexedNames(writer, indexed);
indexed.setName(0, 'replaced');
const corrupt = new BinaryInputArchive(writer.data);
let duplicate = false;
try { loadIndexedNames({ b: () => corrupt.b(), n: () => corrupt.n(), s: () => { corrupt.s(); return ''; } }, indexed); }
catch (e) { duplicate = e instanceof Error; }
assert(duplicate && indexed.find('replaced') === 0 && indexed.find('child') === 1 && !indexed.contains(''));
loadIndexedNames(new BinaryInputArchive(writer.data), indexed);
assert(!indexed.contains('replaced') && indexed.vertex('') === 0 && indexed.find('child') === 1 &&
    indexed.getParent(1) === 0 && indexed.getCount(1) === 29 && indexed.value(IndexedNamesValue.Count, 1) === 19);

include("${CMAKE_CURRENT_LIST_DIR}/TestSupport.cmake")
include("${SOURCE}/cmake/SelfHostManifest.cmake")

function(check_paths label expected actual)
    set(errors "")
    foreach(path IN LISTS expected)
        if(NOT path IN_LIST actual)
            string(APPEND errors "\n  missing: ${path}")
        endif()
    endforeach()
    foreach(path IN LISTS actual)
        if(NOT path IN_LIST expected)
            string(APPEND errors "\n  unexpected: ${path}")
        endif()
    endforeach()
    if(errors)
        message(FATAL_ERROR "${label}:${errors}")
    endif()
endfunction()

set(manifestName "codegen-generated-manifest.json")
read_self_host_paths("${SOURCE}/src/${manifestName}" expectedFiles)
file(GLOB_RECURSE snapshot RELATIVE "${SOURCE}/src" "${SOURCE}/src/generated/*")
check_paths("Self-host snapshot" "${expectedFiles}" "${snapshot}")
list(APPEND expectedFiles "${manifestName}")
test_workspace(work)
set(workspace "${SOURCE}/config/self-host.json")
set(first "${work}/first")
set(second "${work}/second")
set(build "${work}/build")

run("${TOOL}" generate --workspace "${workspace}" --output "${first}")
file(GLOB_RECURSE firstFiles RELATIVE "${first}" "${first}/*")
check_paths("Generator A outputs" "${expectedFiles}" "${firstFiles}")
foreach(path IN LISTS firstFiles)
    run("${CMAKE_COMMAND}" -E compare_files "${first}/${path}" "${SOURCE}/src/${path}")
    file(READ "${first}/${path}" bytes HEX)
    if(bytes MATCHES "^(..)*0d")
        message(FATAL_ERROR "Expected LF in ${path}")
    endif()
endforeach()

set(args -G "${GENERATOR}")
if(PLATFORM)
    list(APPEND args -A "${PLATFORM}")
endif()
if(TOOLSET)
    list(APPEND args -T "${TOOLSET}")
endif()
if(INSTANCE)
    list(APPEND args "-DCMAKE_GENERATOR_INSTANCE=${INSTANCE}")
endif()
if(TOOLCHAIN)
    list(APPEND args "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN}")
endif()
# Use the same installed package or already fetched sources as the parent build.
if(JSON_DIR)
    list(APPEND args "-Dnlohmann_json_DIR=${JSON_DIR}")
elseif(JSON_SOURCE)
    list(APPEND args "-DFETCHCONTENT_SOURCE_DIR_NLOHMANN_JSON=${JSON_SOURCE}")
endif()
if(CONFIG)
    set(buildConfig --config "${CONFIG}")
    set(testConfig -C "${CONFIG}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE}" -B "${build}" ${args} "-DCMAKE_BUILD_TYPE=${CONFIG}"
    "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DCMAKE_PREFIX_PATH=${PREFIX}" -DBUILD_TESTING=ON
    "-DCOCOS_CODEGEN_SELF_HOST_ROOT=${first}" "-DCOCOS_CODEGEN_ENGINE_ROOT=${ENGINE}"
    COMMAND_ERROR_IS_FATAL ANY)
run("${CMAKE_COMMAND}" --build "${build}" ${buildConfig} --parallel)
file(READ "${build}/tests/codegen-${CONFIG}.txt" candidate)
run("${candidate}" generate --workspace "${workspace}" --output "${second}")
file(GLOB_RECURSE secondFiles RELATIVE "${second}" "${second}/*")
check_paths("Generator B outputs" "${firstFiles}" "${secondFiles}")
foreach(path IN LISTS firstFiles)
    run("${CMAKE_COMMAND}" -E compare_files "${first}/${path}" "${second}/${path}")
endforeach()
run("${candidate}" generate --workspace "${workspace}" --output "${first}" --check --diff)

set(engineWorkspace "${SOURCE}/config/workspace.json")
run("${TOOL}" generate --workspace "${engineWorkspace}" --output "${work}/engine")
run("${candidate}" generate --workspace "${engineWorkspace}" --output "${work}/engine" --check --diff)

# Run the candidate's tests, including the parser diagnostics and all configured engine consumers.
run("${CMAKE_CTEST_COMMAND}" --test-dir "${build}" ${testConfig} --output-on-failure --no-tests=error -E "^cocos[.]selfhost$")
finish_workspace("${work}")

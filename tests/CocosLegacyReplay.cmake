# Run from a build directory with -DLEGACY, -DENGINE, -DDEPS and -DMSBUILD on Windows.
include("${CMAKE_CURRENT_LIST_DIR}/CocosTestSupport.cmake")
if(NOT WIN32)
    message(FATAL_ERROR "The historical baseline uses the Windows v143 build")
endif()
foreach(required IN ITEMS LEGACY ENGINE DEPS MSBUILD)
    if(NOT EXISTS "${${required}}")
        message(FATAL_ERROR "Set ${required} to an existing path")
    endif()
endforeach()
set(SOURCE "${CMAKE_CURRENT_LIST_DIR}/..")
file(READ "${SOURCE}/config/cocos-baseline.json" baseline)
string(JSON legacyCommit GET "${baseline}" legacyCommit)
string(JSON engineCommit GET "${baseline}" engineCommit)
test_workspace(work)
run(git -C "${LEGACY}" archive --format=tar -o "${work}/source.tar" "${legacyCommit}")
run(git -C "${ENGINE}" archive --format=tar -o "${work}/engine.tar" "${engineCommit}" native/CMakeLists.txt)
set(sourceDir "${work}/source")
set(engineDir "${work}/cocos4")
file(ARCHIVE_EXTRACT INPUT "${work}/source.tar" DESTINATION "${sourceDir}")
file(ARCHIVE_EXTRACT INPUT "${work}/engine.tar" DESTINATION "${engineDir}")
set(ENV{CL} "/I\"${DEPS}/include\"")
set(ENV{LIB} "${DEPS}/debug/lib;$ENV{LIB}")
set(ENV{PATH} "${DEPS}/debug/bin;$ENV{PATH}")
execute_process(COMMAND "${MSBUILD}" Cocos.sln /t:CocosBuilder /p:Configuration=Debug /p:Platform=x64
    /p:VcpkgEnabled=false /verbosity:quiet /nologo WORKING_DIRECTORY "${sourceDir}" COMMAND_ERROR_IS_FATAL ANY)

set(runDir "${work}/old/bin/run")
file(MAKE_DIRECTORY "${runDir}")
string(JSON count LENGTH "${baseline}" files)
math(EXPR last "${count}-1")
foreach(i RANGE 0 ${last})
    string(JSON path MEMBER "${baseline}" files ${i})
    cmake_path(GET path PARENT_PATH directory)
    file(MAKE_DIRECTORY "${engineDir}/${directory}")
endforeach()
file(SHA256 "${engineDir}/native/CMakeLists.txt" initialCmake)
foreach(pass RANGE 1 2)
    execute_process(COMMAND "${sourceDir}/build/v143/x64/Debug/Cocos.Builder.exe"
        WORKING_DIRECTORY "${runDir}" OUTPUT_FILE "${work}/run-${pass}.log" COMMAND_ERROR_IS_FATAL ANY)
    file(GLOB_RECURSE emitted RELATIVE "${engineDir}" "${engineDir}/*")
    list(LENGTH emitted total)
    if(NOT total EQUAL 53)
        message(FATAL_ERROR "Historical tool produced an unexpected inventory: ${emitted}")
    endif()
    foreach(path IN LISTS emitted)
        file(SHA256 "${engineDir}/${path}" actual)
        if(path STREQUAL "native/CMakeLists.txt")
            set(expected "${initialCmake}")
        else()
            string(JSON expected GET "${baseline}" files "${path}")
        endif()
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Historical output mismatch: ${path}")
        endif()
        file(TIMESTAMP "${engineDir}/${path}" stamp "%s.%f" UTC)
        list(APPEND stamps${pass} "${stamp}")
    endforeach()
endforeach()
if(NOT stamps1 STREQUAL stamps2)
    message(FATAL_ERROR "Historical tool rewrote files on its second pass")
endif()
message(STATUS "Reproduced 52 baseline files and the native CMake list twice")
finish_workspace("${work}")

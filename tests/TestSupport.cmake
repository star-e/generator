cmake_minimum_required(VERSION 3.24)

function(run)
    execute_process(COMMAND ${ARGV} COMMAND_ERROR_IS_FATAL ANY)
endfunction()

function(export_engine_baseline commit destination)
    find_package(Git REQUIRED)
    message(STATUS "Engine reference commit: ${commit}")
    run("${GIT_EXECUTABLE}" -C "${ENGINE}" archive --format=tar -o "${destination}.tar" "${commit}" -- ${ARGN})
    file(ARCHIVE_EXTRACT INPUT "${destination}.tar" DESTINATION "${destination}")
endfunction()

function(expect_failure code pattern)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc ERROR_VARIABLE error)
    if(NOT rc STREQUAL "${code}" OR NOT error MATCHES "${pattern}")
        message(FATAL_ERROR "Expected ${code} and ${pattern}, got ${rc}: ${error}")
    endif()
endfunction()

function(check_line_endings path style)
    # CMake reads CRLF text as LF. Reconstruct the expected bytes and compare with the file on disk.
    file(READ "${path}" content)
    string(REPLACE "\r" "\n" content "${content}")
    if(style STREQUAL "crlf" OR (style STREQUAL "native" AND CMAKE_HOST_WIN32))
        string(REPLACE "\n" "\r\n" content "${content}")
    endif()
    string(SHA256 expected "${content}")
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Expected ${style} line endings in ${path}")
    endif()
endfunction()

function(build_consumer project build stage)
    set(args -G "${GENERATOR}")
    if(PLATFORM)
        list(APPEND args -A "${PLATFORM}")
    endif()
    if(TOOLSET)
        list(APPEND args -T "${TOOLSET}")
    endif()
    if(TOOLCHAIN)
        list(APPEND args "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN}")
    endif()
    if(CONFIG)
        set(configArg --config "${CONFIG}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${project}" -B "${build}"
        ${args} "-DSTAGING=${stage}" "-DENGINE=${ENGINE}" "-DCMAKE_PREFIX_PATH=${PREFIX}" "-DCMAKE_BUILD_TYPE=${CONFIG}" ${ARGN}
        COMMAND_ERROR_IS_FATAL ANY)
    run("${CMAKE_COMMAND}" --build "${build}" ${configArg})
endfunction()

function(test_workspace result)
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
    set(dir "${CMAKE_CURRENT_BINARY_DIR}/cocos-test-${suffix}")
    if(EXISTS "${dir}")
        message(FATAL_ERROR "Test directory already exists: ${dir}")
    endif()
    file(MAKE_DIRECTORY "${dir}")
    message(STATUS "Test workspace: ${dir}")
    set(${result} "${dir}" PARENT_SCOPE)
endfunction()

function(finish_workspace dir)
    file(REAL_PATH "${dir}" target)
    cmake_path(GET target PARENT_PATH parent)
    cmake_path(GET target FILENAME name)
    file(REAL_PATH "${CMAKE_CURRENT_BINARY_DIR}" root)
    if(NOT parent STREQUAL root OR NOT name MATCHES "^cocos-test-[0-9a-f]+$")
        message(FATAL_ERROR "Unexpected test directory: ${target}")
    endif()
    file(REMOVE_RECURSE "${target}")
endfunction()

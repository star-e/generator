    string(REPLACE "ccstd::vector<uint8_t>" "${source}" invalid "${originalTypes}")
    file(WRITE "${types}" "${invalid}")
    expect_failure(2 "types[.]spec:[0-9]+:5: wrong number of template arguments for ccstd::vector" ${generate})
endforeach()
foreach(source IN ITEMS "ccstd::map<uint8_t>" "ccstd::map<uint8_t, uint32_t, uint8_t>")
    string(REPLACE "ccstd::vector<uint8_t>" "${source}" invalid "${originalTypes}")
    file(WRITE "${types}" "${invalid}")
    expect_failure(2 "types[.]spec:[0-9]+:5: wrong number of template arguments for ccstd::map" ${generate})
endforeach()

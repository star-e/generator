# Consumer-first and provider-first workspaces must plan the same files.
file(READ "${workspace}" config)
string(JSON count LENGTH "${config}" modules)
math(EXPR last "${count} - 1")
set(reordered "[]")
foreach(i RANGE 0 ${last})
    math(EXPR j "${last} - ${i}")
    string(JSON module GET "${config}" modules ${j})
    string(JSON reordered SET "${reordered}" ${i} "${module}")
    string(JSON spec GET "${module}" spec)
    if(spec STREQUAL "../spec/render/render-common.spec")
        set(commonModule ${i})
    elseif(spec STREQUAL "../spec/extern/gfx.spec")
        set(gfxModule ${i})
    elseif(spec STREQUAL "../spec/render/layout-graph.spec")
        set(layoutModule ${i})
    elseif(spec STREQUAL "../spec/render/archive.spec")
        set(archiveModule ${i})
    endif()
endforeach()
string(JSON config SET "${config}" modules "${reordered}")
file(WRITE "${workspace}" "${config}")
run(${generate} --check --diff)


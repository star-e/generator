    file(WRITE "${containers}" "${invalid}")
    expect_failure(2 "containers[.]spec:[0-9]+:[0-9]+: @container.*requires exactly one type parameter" ${generate})
endforeach()
foreach(declaration IN ITEMS "template<K> class map" "template<K, V, W> class map")

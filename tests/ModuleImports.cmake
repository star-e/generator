include("${CMAKE_CURRENT_LIST_DIR}/TestSupport.cmake")
test_workspace(work)
file(COPY "${SOURCE}/spec" "${SOURCE}/config" "${SOURCE}/runtime" DESTINATION "${work}")
set(workspace "${work}/config/workspace.json")
set(generate "${TOOL}" generate --workspace "${workspace}" --output "${work}/stage")
run(${generate})

set(strings "${work}/spec/extern/strings.spec")
file(READ "${strings}" originalStrings)
foreach(annotation IN ITEMS string pmr)
    string(REPLACE "@${annotation}" "@${annotation} @${annotation}" duplicate "${originalStrings}")
    file(WRITE "${strings}" "${duplicate}")
    expect_failure(2 "strings[.]spec:[0-9]+:[0-9]+: unknown or duplicate external type annotation @${annotation}" ${generate})
    string(REPLACE "@${annotation}" "@${annotation}()" arguments "${originalStrings}")
    file(WRITE "${strings}" "${arguments}")
    expect_failure(2 "strings[.]spec:[0-9]+:[0-9]+: @${annotation} takes no arguments" ${generate})
endforeach()
file(WRITE "${strings}" "${originalStrings}")

set(containers "${work}/spec/extern/containers.spec")
file(READ "${containers}" containerSource)
foreach(declaration IN ITEMS "class vector" "template<T, U> class vector")
    string(REPLACE "template<T> class vector" "${declaration}" invalid "${containerSource}")
    file(WRITE "${containers}" "${invalid}")
    expect_failure(2 "containers[.]spec:[0-9]+:[0-9]+: @container.*requires exactly one type parameter" ${generate})
endforeach()
foreach(declaration IN ITEMS "template<K> class map" "template<K, V, W> class map")
    string(REPLACE "template<K, V> class map" "${declaration}" invalid "${containerSource}")
    file(WRITE "${containers}" "${invalid}")
    expect_failure(2 "containers[.]spec:[0-9]+:[0-9]+: @container.*requires exactly two type parameters" ${generate})
endforeach()
file(WRITE "${containers}" "${containerSource}")

set(sets "${work}/spec/extern/sets.spec")
file(READ "${sets}" setSource)
foreach(declaration IN ITEMS "class PmrTransparentSet" "template<T, U> class PmrTransparentSet")
    string(REPLACE "template<T> class PmrTransparentSet" "${declaration}" invalid "${setSource}")
    file(WRITE "${sets}" "${invalid}")
    expect_failure(2 "sets[.]spec:[0-9]+:[0-9]+: @container.*requires exactly one type parameter" ${generate})
endforeach()
file(WRITE "${sets}" "${setSource}")

set(types "${work}/spec/extern/types.spec")
file(READ "${types}" originalTypes)
set(archive "${work}/spec/render/archive.spec")
file(READ "${archive}" originalArchive)
string(REPLACE "module ArchiveInterface;" "module ArchiveInterface; import Containers;" withImport "${originalArchive}")
file(WRITE "${archive}" "${withImport}\nbinding typescript { ::ccstd::vector< ::uint8_t > => Uint8ClampedArray; }\n")
expect_failure(2 "archive[.]spec:[0-9]+:22: duplicate TypeScript binding for ccstd::vector<uint8_t> [(]first bound at [^\n]*types[.]spec:[0-9]+:5[)]" ${generate})
file(WRITE "${archive}" "${originalArchive}")
string(REPLACE "ccstd::vector<uint8_t>" "ccstd::vector<uint32_t>" otherInstance "${originalTypes}")
file(WRITE "${types}" "${otherInstance}")
run(${generate})
file(READ "${work}/stage/cocos/rendering/custom/types.ts" script)
string(FIND "${script}" "source: number[] = []" fallback)
if(fallback EQUAL -1)
    message(FATAL_ERROR "Removing the byte-vector override did not restore the array binding")
endif()
foreach(target IN ITEMS "UnknownArray" [[Uint8Array from "arrays"]])
    string(REPLACE "=> Uint8Array;" "=> ${target};" invalid "${originalTypes}")
    file(WRITE "${types}" "${invalid}")
    expect_failure(2 "types[.]spec:[0-9]+:5: expected a built-in ES2015 TypedArray target without an import for ccstd::vector<uint8_t>" ${generate})
endforeach()
string(REPLACE "vector<uint8_t>" "vector<bool<uint8_t>>" invalid "${originalTypes}")
file(WRITE "${types}" "${invalid}")
expect_failure(2 "types[.]spec:[0-9]+:[0-9]+: expected an external template for bool" ${generate})
foreach(source IN ITEMS "ccstd::vector" "ccstd::vector<uint8_t, uint32_t>")
    string(REPLACE "ccstd::vector<uint8_t>" "${source}" invalid "${originalTypes}")
    file(WRITE "${types}" "${invalid}")
    expect_failure(2 "types[.]spec:[0-9]+:5: wrong number of template arguments for ccstd::vector" ${generate})
endforeach()
foreach(source IN ITEMS "ccstd::map<uint8_t>" "ccstd::map<uint8_t, uint32_t, uint8_t>")
    string(REPLACE "ccstd::vector<uint8_t>" "${source}" invalid "${originalTypes}")
    file(WRITE "${types}" "${invalid}")
    expect_failure(2 "types[.]spec:[0-9]+:5: wrong number of template arguments for ccstd::map" ${generate})
endforeach()
file(WRITE "${types}" "${originalTypes}")
run(${generate})

# Consumer-first and provider-first workspaces must plan the same files.
file(READ "${workspace}" config)
string(JSON count LENGTH "${config}" modules)
math(EXPR last "${count} - 1")
set(reordered "[]")
foreach(i RANGE 0 ${last})
    math(EXPR j "${last} - ${i}")
    string(JSON module GET "${config}" modules ${j})
    string(JSON reordered SET "${reordered}" ${i} "${module}")
    string(JSON spec GET "${module}" spec)
    if(spec STREQUAL "../spec/render/render-common.spec")
        set(commonModule ${i})
    endif()
endforeach()
string(JSON config SET "${config}" modules "${reordered}")
file(WRITE "${workspace}" "${config}")
run(${generate} --check --diff)

# Imports follow the generated enum provider's output paths.
string(JSON relocated SET "${config}" modules ${commonModule} header [["moved/Common.h"]])
string(JSON relocated SET "${relocated}" modules ${commonModule} namesHeader [["moved/CommonLookup.h"]])
string(JSON relocated SET "${relocated}" modules ${commonModule} typescript [["cocos/rendering/moved/common.ts"]])
file(WRITE "${workspace}" "${relocated}")
run("${TOOL}" generate --workspace "${workspace}" --output "${work}/moved")
file(READ "${work}/moved/native/cocos/renderer/pipeline/custom/LayoutGraphTypes.h" header)
file(READ "${work}/moved/native/cocos/renderer/pipeline/custom/LayoutGraphNames.h" namesHeader)
file(READ "${work}/moved/cocos/rendering/custom/layout-graph.ts" script)
string(FIND "${header}" [[#include "moved/Common.h"]] headerImport)
string(FIND "${namesHeader}" [[#include "moved/CommonLookup.h"]] namesImport)
string(FIND "${script}" [[import { ParameterType, UpdateFrequency } from '../moved/common';]] scriptImport)
string(FIND "${script}" [[import type { RenderCommonObjectPool } from '../moved/common';]] poolImport)
if(headerImport EQUAL -1 OR namesImport EQUAL -1 OR scriptImport EQUAL -1 OR poolImport EQUAL -1)
    message(FATAL_ERROR "LayoutGraph did not import types, names and the object pool from the relocated provider")
endif()
file(WRITE "${workspace}" "${config}")
set(layout "${work}/spec/render/layout-graph.spec")
set(gfx "${work}/spec/extern/gfx.spec")
file(READ "${gfx}" originalGfx)
string(REPLACE [[Type => Type from "cocos/gfx";]] [[::cc::gfx::Type => extern enum DeviceType from "cocos/device";]] renamed "${originalGfx}")
file(WRITE "${gfx}" "${renamed}")
run("${TOOL}" generate --workspace "${workspace}" --output "${work}/renamed")
file(READ "${work}/renamed/cocos/rendering/custom/layout-graph.ts" script)
string(FIND "${script}" [[import { DeviceType } from '../../device';]] at)
if(at EQUAL -1 OR NOT script MATCHES "type: DeviceType = DeviceType.UNKNOWN")
    message(FATAL_ERROR "The consuming module lost the external enum binding")
endif()
file(APPEND "${gfx}" [[binding typescript { cc::gfx::Type => AnotherType; }]])
expect_failure(2 "gfx[.]spec:[0-9]+:[0-9]+: duplicate TypeScript binding for cc::gfx::Type" ${generate})
file(WRITE "${gfx}" "${originalGfx}")
file(READ "${layout}" originalLayout)
string(REPLACE "PmrTransparentSet<ccstd::pmr::string>" "PmrTransparentSet<ccstd::pmr::string, uint32_t>" invalid "${originalLayout}")
file(WRITE "${layout}" "${invalid}")
expect_failure(2 "layout-graph[.]spec:[0-9]+:[0-9]+: wrong number of template arguments for cc::PmrTransparentSet" ${generate})
string(REPLACE "import RenderCommon;" "" missing "${originalLayout}")
file(WRITE "${layout}" "${missing}")
expect_failure(2 "cc::render::UpdateFrequency requires import RenderCommon in module LayoutGraph" ${generate})
file(WRITE "${layout}" "${originalLayout}")

set(common "${work}/spec/render/render-common.spec")
file(READ "${common}" original)
file(STRINGS "${common}" commonLines)
list(FIND commonLines "        nullable light: IntrusivePtr<scene::Light>;" lightIndex)
list(FIND commonLines "        nullable probe: scene::ReflectionProbe* = nullptr;" probeIndex)
math(EXPR lightLine "${lightIndex} + 1")
math(EXPR probeLine "${probeIndex} + 1")
function(change_imports before after)
    string(REPLACE "${before}" "${after}" changed "${original}")
    file(WRITE "${common}" "${changed}")
endfunction()

change_imports("import Gfx;" "")
expect_failure(2 "render-common.spec:[0-9]+:[0-9]+: cc::gfx::ResolveMode requires import Gfx in module RenderCommon" ${generate})
change_imports("import ArchiveInterface;" "")
expect_failure(2 "serialization requires import ArchiveInterface" ${generate})
change_imports("import ReflectionProbe;" "")
expect_failure(2 "render-common.spec:${probeLine}:25: cc::scene::ReflectionProbe requires import ReflectionProbe in module RenderCommon" ${generate})
change_imports("import Light;" "")
expect_failure(2 "render-common.spec:${lightLine}:38: cc::scene::Light requires import Light in module RenderCommon" ${generate})

# A provider's own imports do not make a third module's names visible to its consumer.
set(probe "${work}/spec/extern/reflection-probe.spec")
file(READ "${probe}" provider)
string(REPLACE "namespace" "import Light;\nnamespace" indirect "${provider}")
file(WRITE "${probe}" "${indirect}")
expect_failure(2 "render-common.spec:${lightLine}:38: cc::scene::Light requires import Light" ${generate})

change_imports("import Light;" "import Missing;")
expect_failure(2 "render-common.spec:2:8: unknown imported module Missing" ${generate})
change_imports("import ReflectionProbe;" "import Light;")
expect_failure(2 "render-common.spec:3:8: duplicate import Light" ${generate})
file(WRITE "${common}" "${original}")
string(REPLACE "namespace" "import RenderCommon;\nnamespace" cyclic "${provider}")
file(WRITE "${probe}" "${cyclic}")
expect_failure(2 "module import cycle: (RenderCommon -> ReflectionProbe -> RenderCommon|ReflectionProbe -> RenderCommon -> ReflectionProbe)" ${generate})
file(WRITE "${probe}" "${provider}")

set(graphSpec "${work}/spec/graph.spec")
string(JSON config SET "${config}" modules ${count} [[{"backend":"model","spec":"../spec/graph.spec"}]])
file(WRITE "${workspace}" "${config}")
set(graph "module GraphConsumer;
import RenderCommon;
namespace cc::render {
    graph Passes {
        vertex_descriptor Vertex = uint32_t;
        vertex_storage: indexed;
        component RasterPassTag: uint32_t { member: passes; }
    }
}")
file(WRITE "${graphSpec}" "${graph}")
run(${generate} --check --diff)
function(bad_graph before after error)
    string(REPLACE "${before}" "${after}" broken "${graph}")
    file(WRITE "${graphSpec}" "${broken}")
    expect_failure(2 "graph.spec:[0-9]+:[0-9]+: ${error}" ${generate})
endfunction()
bad_graph("import RenderCommon;" "" "cc::render::RasterPassTag requires import RenderCommon")
bad_graph("RasterPassTag:" "MissingTag:" "unknown type MissingTag")
bad_graph("RasterPassTag:" "LightInfo:" "component requires an independently declared @tag")
bad_graph("component RasterPassTag:" "@tag struct LocalTag {} component LocalTag:" "declare graph tags outside the graph")
bad_graph("vertex_storage: indexed;" "vertex_list_graph; vertex_list_graph;" "duplicate vertex_list_graph")
bad_graph("vertex_storage: indexed;" "mutable_graph; mutable_graph;" "duplicate mutable_graph")
bad_graph("vertex_storage: indexed;" "hierarchy_graph { storage: separate; }" "expected 'shared_edges'")
bad_graph("vertex_storage: indexed;" "hierarchy_graph { storage: shared_edges; }" "shared hierarchy edges require indexed vertex storage")
bad_graph("vertex_storage: indexed;" "hierarchy_graph { storage: shared_edges; } hierarchy_graph { storage: shared_edges; }" "duplicate hierarchy_graph")
set(storage "vertex_storage: indexed;")
set(branch "BufferTag: uint32_t { member: buffers; }")
set(poly "polymorphic_graph { ${branch} }")
bad_graph("${storage}" "${storage} polymorphic_graph {}" "polymorphic_graph requires at least one alternative")
bad_graph("${storage}" "${storage} ${poly} ${poly}" "duplicate polymorphic_graph")
bad_graph("${storage}" "${storage} polymorphic_graph { ${branch} BufferTag: bool { member: flags; } }" "invalid or duplicate alternative kind")
bad_graph("${storage}" "${storage} polymorphic_graph { LightInfo: uint32_t { member: data; } }" "alternative requires an independently declared @tag")
bad_graph("${storage}" "${storage} polymorphic_graph { BufferTag: Missing { member: data; } }" "unknown type Missing")
bad_graph("${storage}" "${storage} polymorphic_graph { BufferTag: uint32_t { member: passes; } }" "duplicate name 'passes'")
set(named "named_graph { component: RasterPassTag; }")
bad_graph("${storage}" "${storage} ${named} ${named}" "duplicate named_graph")
bad_graph("${storage}" "${storage} parent_graph; parent_graph;" "duplicate parent_graph")
bad_graph("${storage}" "${storage} addressable_graph; addressable_graph;" "duplicate addressable_graph")
bad_graph("${storage}" "${storage} hierarchy_graph { storage: shared_edges; } addressable_graph;" "addressable_graph requires parent_graph")
bad_graph("${storage}" "${storage} parent_graph;" "parent_graph requires hierarchy_graph")
bad_graph("${storage}" "${storage} hierarchy_graph { storage: shared_edges; } parent_graph;" "parent_graph requires named_graph")
bad_graph("${storage}" "${storage} named_graph { component: BufferTag; }" "named_graph requires a component of this graph: BufferTag")
bad_graph("${storage}" "${storage} ${named}" "named_graph requires a string component: RasterPassTag")
bad_graph("component RasterPassTag:" "component RasterPassTag: uint32_t { member: first; } component RasterPassTag:" "invalid or duplicate component accessor")

finish_workspace("${work}")

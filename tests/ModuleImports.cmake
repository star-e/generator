include("${CMAKE_CURRENT_LIST_DIR}/TestSupport.cmake")
test_workspace(work)
file(COPY "${SOURCE}/spec" "${SOURCE}/config" "${SOURCE}/runtime" DESTINATION "${work}")
set(workspace "${work}/config/workspace.json")
set(generate "${TOOL}" generate --workspace "${workspace}" --output "${work}/stage")
run(${generate})

file(READ "${work}/stage/native/cocos/renderer/pipeline/custom/LayoutGraphTypes.h" graphHeader)
if(graphHeader MATCHES "ArchiveFwd[.]h")
    message(FATAL_ERROR "Public graph fields do not require an archive header in LayoutGraphTypes.h")
endif()

set(resources "${work}/spec/extern/gfx.spec")
file(READ "${resources}" resourceSource)
set(resourcePattern "cocos/renderer/gfx-base/GFX{name}.h")
string(REPLACE "${resourcePattern}" "moved/GFX{name}.h" relocatedResources "${resourceSource}")
file(WRITE "${resources}" "${relocatedResources}")
run(${generate})
file(READ "${work}/stage/native/cocos/renderer/pipeline/custom/RenderGraphTypes.h" header)
foreach(path IN ITEMS moved/GFXBuffer.h moved/GFXTexture.h cocos/renderer/gfx-base/GFXDef-common.h
                      cocos/renderer/gfx-base/states/GFXSampler.h)
    string(FIND "${header}" "#include \"${path}\"" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "Missing grouped include ${path}")
    endif()
endforeach()
if(header MATCHES "cocos/renderer/gfx-base/GFX(Buffer|Texture)[.]h")
    message(FATAL_ERROR "Stale includes after changing the Gfx header pattern")
endif()
file(READ "${work}/stage/native/cocos/renderer/pipeline/custom/RenderInterfaceTypes.h" header)
if(header MATCHES "GFX(Device|Texture|Sampler)[.]h" OR NOT header MATCHES "gfx-base/GFXDef-common[.]h" OR
   NOT header MATCHES "moved/GFXCommandBuffer[.]h")
    message(FATAL_ERROR "Expected Gfx forward declarations for interface pointers and the definition for a nested template argument")
endif()
string(REPLACE "{name}" "{type}" invalid "${resourceSource}")
file(WRITE "${resources}" "${invalid}")
expect_failure(2 "gfx[.]spec:[0-9]+:[0-9]+: expected [{]name[}] as the header placeholder" ${generate})
string(REPLACE "${resourcePattern}" "../{name}.h" invalid "${resourceSource}")
file(WRITE "${resources}" "${invalid}")
expect_failure(2 "gfx[.]spec:[0-9]+:[0-9]+: expected a relative C[+][+] include path" ${generate})
file(WRITE "${resources}" "${resourceSource}")

set(strings "${work}/spec/extern/strings.spec")
file(READ "${strings}" originalStrings)
foreach(annotation IN ITEMS string pmr)
    string(REPLACE "@${annotation}" "@${annotation} @${annotation}" duplicate "${originalStrings}")
    file(WRITE "${strings}" "${duplicate}")
    expect_failure(2 "strings[.]spec:[0-9]+:[0-9]+: unknown or duplicate external type annotation @${annotation}" ${generate})
    string(REPLACE "@${annotation}" "@${annotation}()" arguments "${originalStrings}")
    file(WRITE "${strings}" "${arguments}")
    expect_failure(2 "strings[.]spec:[0-9]+:[0-9]+: @${annotation} takes no arguments" ${generate})
endforeach()
file(WRITE "${strings}" "${originalStrings}")

set(containers "${work}/spec/extern/containers.spec")

include("${CMAKE_CURRENT_LIST_DIR}/TestSupport.cmake")
file(READ "${SOURCE}/config/baseline.json" baseline)
string(JSON count LENGTH "${baseline}" files)
if(NOT count EQUAL 52)
    message(FATAL_ERROR "Expected 52 historical paths")
endif()
file(READ "${ENGINE}/native/CMakeLists.txt" cmake)
string(REGEX MATCH "##### renderer[^\n]*\n[^)]*\\)" renderer "${cmake}")
if(NOT renderer)
    message(FATAL_ERROR "Renderer source list missing")
endif()
set(nativeCount 0)
math(EXPR last "${count} - 1")
foreach(i RANGE 0 ${last})
    string(JSON path MEMBER "${baseline}" files ${i})
    string(JSON expected GET "${baseline}" files "${path}")
    file(READ "${ENGINE}/${path}" content)
    # The historical generator used Windows text mode. Recreate its CRLF bytes on LF checkouts.
    string(REPLACE "\r\n" "\n" content "${content}")
    string(REPLACE "\n" "\r\n" content "${content}")
    string(SHA256 actual "${content}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Engine baseline mismatch: ${path}")
    endif()
    if(path MATCHES "^native/(cocos/.+)$")
        set(sourcePath "${CMAKE_MATCH_1}")
        string(REGEX MATCHALL "[ \t\n]${sourcePath}[\r\n)]" matches "${renderer}")
        list(LENGTH matches found)
        if(NOT found EQUAL 1)
            message(FATAL_ERROR "Expected one renderer entry for ${sourcePath}")
        endif()
        math(EXPR nativeCount "${nativeCount}+1")
    endif()
endforeach()
if(NOT nativeCount EQUAL 41)
    message(FATAL_ERROR "Expected 41 native sources, found ${nativeCount}")
endif()

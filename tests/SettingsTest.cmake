include("${CMAKE_CURRENT_LIST_DIR}/TestSupport.cmake")
test_workspace(work)
file(COPY "${SOURCE}/spec" "${SOURCE}/config" DESTINATION "${work}")
set(workspace "${work}/config/workspace.json")
file(READ "${workspace}" config)
set(selected "[]")
string(JSON count LENGTH "${config}" modules)
math(EXPR last "${count} - 1")
foreach(i RANGE 0 ${last})
    string(JSON module GET "${config}" modules ${i})
    string(JSON spec GET "${module}" spec)
    if(spec MATCHES "/(types|strings|containers|gfx|render-settings)[.]spec$")
        string(JSON index LENGTH "${selected}")
        string(JSON selected SET "${selected}" ${index} "${module}")
    endif()
endforeach()
string(JSON config SET "${config}" modules "${selected}")
file(WRITE "${workspace}" "${config}")
set(spec "${work}/spec/render/render-settings.spec")
set(output "${work}/staging")
set(generate "${TOOL}" generate --workspace "${workspace}" --output "${output}")
file(READ "${spec}" original)
set(nativeTypes "${work}/spec/extern/types.spec")
file(READ "${nativeTypes}" bindings)
string(REPLACE [[cc::Material => "Material";]] [[cc::Material => MaterialAsset from "cocos/assets";]] imported "${bindings}")
file(WRITE "${nativeTypes}" "${imported}")
run(${generate})
file(READ "${output}/editor/assets/default_renderpipeline/builtin-pipeline-types.ts" rebound)
string(FIND "${rebound}" [[import { MaterialAsset } from '../../../cocos/assets';]] at)
if(at EQUAL -1 OR NOT rebound MATCHES "kawaseFilterMaterial: MaterialAsset")
    message(FATAL_ERROR "Editor settings did not follow the external type binding")
endif()
file(WRITE "${nativeTypes}" "${bindings}")
string(REPLACE "threshold: float = 0.8" "cutoff: float = 0.25" changed "${original}")
string(REPLACE "module RenderSettings;" "module RenderSettings; import Strings; import Containers;" changed "${changed}")
string(REPLACE "struct MSAA {" "struct MSAA { label: ccstd::pmr::string; bytes: ccstd::vector<uint8_t>; labels: ccstd::vector<ccstd::string>; counts: ccstd::map<ccstd::string, uint32_t>;" changed "${changed}")
string(REPLACE "MipmapFilter," "MipmapFilter, LegacyFilter = MipmapFilter," changed "${changed}")
string(REPLACE "iterations: uint32_t = 3" "iterations: uint32_t = 0xA" changed "${changed}")
file(WRITE "${spec}" "${changed}")
run(${generate})
file(GLOB_RECURSE paths RELATIVE "${output}" "${output}/*")
if(NOT paths STREQUAL "editor/assets/default_renderpipeline/builtin-pipeline-types.ts")
    message(FATAL_ERROR "Unexpected settings outputs: ${paths}")
endif()
file(READ "${output}/${paths}" ts)
foreach(fragment IN ITEMS "cutoff: number; /* 0.25 */" "cutoff: 0.25," "value.cutoff = 0.25;" "LegacyFilter = MipmapFilter,"
                          "iterations: 0xA," "value.iterations = 0xA;" "label: string;" "label: ''," "value.label = '';"
                          "bytes: Uint8Array;" "bytes: new Uint8Array(0)," "value.bytes = new Uint8Array(0);"
                          "labels: string[];" "labels: []," "value.labels = [];"
                          "counts: Map<string, number>;" "counts: new Map<string, number>()," "value.counts = new Map<string, number>();")
    string(FIND "${ts}" "${fragment}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing generated field: ${fragment}")
    endif()
endforeach()

string(REPLACE "BloomType::KawaseDualFilter" "BloomType::Missing" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "render-settings.spec:[0-9]+:[0-9]+: invalid enum default BloomType::Missing" ${generate})
string(REPLACE "readonly msaa: MSAA" "readonly msaa: PipelineSettings" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "cyclic by-value field cc::render::PipelineSettings.msaa" ${generate})
string(REPLACE "renamedFrom material;" "renamedFrom threshold;" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "invalid settings migration Bloom.kawaseFilterMaterial from threshold" ${generate})
finish_workspace("${work}")

include("${CMAKE_CURRENT_LIST_DIR}/TestSupport.cmake")
test_workspace(work)
file(COPY "${SOURCE}/spec" "${SOURCE}/config" DESTINATION "${work}")
set(workspace "${work}/config/workspace.json")
file(READ "${workspace}" config)
string(JSON config REMOVE "${config}" modules 0)
file(WRITE "${workspace}" "${config}")
set(spec "${work}/spec/render/render-settings.spec")
set(output "${work}/staging")
set(generate "${TOOL}" generate --workspace "${workspace}" --output "${output}")
file(READ "${spec}" original)
string(REPLACE "threshold: float = 0.8" "cutoff: float = 0.25" changed "${original}")
file(WRITE "${spec}" "${changed}")
run(${generate})
file(GLOB_RECURSE paths RELATIVE "${output}" "${output}/*")
if(NOT paths STREQUAL "editor/assets/default_renderpipeline/builtin-pipeline-types.ts")
    message(FATAL_ERROR "Unexpected settings outputs: ${paths}")
endif()
file(READ "${output}/${paths}" ts)
foreach(fragment IN ITEMS "cutoff: number; /* 0.25 */" "cutoff: 0.25," "value.cutoff = 0.25;")
    string(FIND "${ts}" "${fragment}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing generated field: ${fragment}")
    endif()
endforeach()

string(REPLACE "BloomType::KawaseDualFilter" "BloomType::Missing" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "render-settings.spec:[0-9]+:[0-9]+: invalid enum default BloomType::Missing" ${generate})
string(REPLACE "readonly msaa: MSAA" "readonly msaa: PipelineSettings" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "cyclic by-value field cc::render::PipelineSettings.msaa" ${generate})
file(WRITE "${spec}" "${original}")
set(projection "${work}/spec/render/render-settings.json")
file(READ "${projection}" rules)
string(JSON rules SET "${rules}" renamedFrom Bloom kawaseFilterMaterial "\"threshold\"")
file(WRITE "${projection}" "${rules}")
expect_failure(2 "invalid settings migration Bloom.kawaseFilterMaterial from threshold" ${generate})
finish_workspace("${work}")

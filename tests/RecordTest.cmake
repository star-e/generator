include("${CMAKE_CURRENT_LIST_DIR}/TestSupport.cmake")
test_workspace(work)
file(COPY "${SOURCE}/spec" "${SOURCE}/config" DESTINATION "${work}")
set(spec "${work}/spec/render/render-common.spec")
file(READ "${spec}" original)
set(generate "${TOOL}" generate --workspace "${work}/config/workspace.json" --output "${work}/stage")

set(layoutSpec "${work}/spec/render/layout-graph.spec")
file(READ "${layoutSpec}" layout)
set(layoutHeader "${work}/stage/native/cocos/renderer/pipeline/custom/LayoutGraphTypes.h")
string(REPLACE "DescriptorBlockIndex => class { mapKey json; };" "" ordinaryKey "${layout}")
file(WRITE "${layoutSpec}" "${ordinaryKey}")
run(${generate})
file(READ "${work}/stage/cocos/rendering/custom/layout-graph.ts" ordinaryTs)
if(NOT ordinaryTs MATCHES "blocks: Map<DescriptorBlockIndex, DescriptorBlock>" OR
   NOT ordinaryTs MATCHES "groupBlocks: Map<string, DescriptorBlock>")
    message(FATAL_ERROR "Removing one mapKey binding must only change that key type")
endif()
string(REPLACE "mapKey json;" "mapKey json; mapKey json;" duplicate "${layout}")
file(WRITE "${layoutSpec}" "${duplicate}")
expect_failure(2 "layout-graph[.]spec:[0-9]+:[0-9]+: duplicate binding option mapKey" ${generate})
string(REPLACE "mapKey json;" "mapKey number;" invalid "${layout}")
file(WRITE "${layoutSpec}" "${invalid}")
expect_failure(2 "layout-graph[.]spec:[0-9]+:[0-9]+: expected .*json" ${generate})
string(REPLACE "struct Descriptor {" "@requireAllocator struct Descriptor {" invalid "${layout}")
file(WRITE "${layoutSpec}" "${invalid}")
expect_failure(2 "cc::render::Descriptor: @requireAllocator requires a PMR field" ${generate})
string(REPLACE "RenderStage_: RenderPassType" "RenderStage_: void" invalid "${layout}")
file(WRITE "${layoutSpec}" "${invalid}")
expect_failure(2 "LayoutGraph.stages: polymorphic storage requires a copyable object type" ${generate})
string(REPLACE "member: phases;" "member: value;" invalid "${layout}")
file(WRITE "${layoutSpec}" "${invalid}")
expect_failure(2 "LayoutGraph: polymorphic graph member name collision: value" ${generate})
foreach(suffix IN ITEMS Value ValueType Object)
    string(REPLACE "graph LayoutGraph {" "struct LayoutGraph${suffix} {} graph LayoutGraph {" invalid "${layout}")
    file(WRITE "${layoutSpec}" "${invalid}")
    expect_failure(2 "LayoutGraph: TypeScript graph export collides with LayoutGraph${suffix}" ${generate})
endforeach()
string(REPLACE "Name_" "Parent_" invalid "${layout}")
file(WRITE "${layoutSpec}" "${invalid}")
expect_failure(2 "LayoutGraph: component accessor collides with TypeScript getParent" ${generate})
function(bad_comparison annotation error)
    string(REPLACE [[@comparison("<")]] "${annotation}" invalid "${layout}")
    file(WRITE "${layoutSpec}" "${invalid}")
    expect_failure(2 "layout-graph[.]spec:[0-9]+:[0-9]+: ${error}" ${generate})
endfunction()
bad_comparison([[@comparison()]] "expected quoted comparison operator")
bad_comparison([[@comparison("<=")]] "unsupported comparison operator")
bad_comparison([[@comparison("<", "<")]] "duplicate comparison operator")
bad_comparison([[@comparison("<") @comparison("==")]] "unknown or duplicate record annotation @comparison")
bad_comparison([[@hash @hash]] "unknown or duplicate record annotation @hash")
string(REPLACE "enum class LayoutType" [[@comparison("==") enum class LayoutType]] invalid "${layout}")
file(WRITE "${layoutSpec}" "${invalid}")
expect_failure(2 "layout-graph[.]spec:[0-9]+:[0-9]+: @comparison requires a struct" ${generate})
string(REPLACE "addressable_graph;" "" parentOnly "${layout}")
file(WRITE "${layoutSpec}" "${parentOnly}")
run(${generate})
file(READ "${layoutHeader}" parentHeader)
if(parentHeader MATCHES " locate[(]| exists[(]| path[(]" OR NOT parentHeader MATCHES "locate_child[(]")
    message(FATAL_ERROR "Path resolution must be enabled independently of child lookup")
endif()
file(READ "${work}/stage/cocos/rendering/custom/layout-graph.ts" parentScript)
if(parentScript MATCHES " (locate|locateRelative|path) [(]" OR NOT parentScript MATCHES "locateChild [(]")
    message(FATAL_ERROR "TS path methods must be enabled independently of child lookup")
endif()
string(REPLACE "parent_graph;" "" hierarchyOnly "${parentOnly}")
file(WRITE "${layoutSpec}" "${hierarchyOnly}")
run(${generate})
file(READ "${layoutHeader}" hierarchyHeader)
if(hierarchyHeader MATCHES "locate_child[(]" OR NOT hierarchyHeader MATCHES "get_parent[(]")
    message(FATAL_ERROR "Only parent_graph should enable named child lookup")
endif()
string(REPLACE "hierarchy_graph { storage: shared_edges; }" "" flat "${hierarchyOnly}")
file(WRITE "${layoutSpec}" "${flat}")
run(${generate})
file(READ "${layoutHeader}" flatHeader)
if(flatHeader MATCHES "child_links[(]|get_parent[(]|num_children[(]|VertexLinks" OR NOT flatHeader MATCHES "add_vertex[(]")
    message(FATAL_ERROR "Flat graph did not preserve its original vertex interface")
endif()
file(READ "${work}/stage/cocos/rendering/custom/layout-graph.ts" script)
if(script MATCHES "from './graph'|numChildren [(]" OR NOT script MATCHES "j<T extends LayoutGraphObject>")
    message(FATAL_ERROR "A flat polymorphic graph should expose its payload without the hierarchy runtime")
endif()
foreach(capability IN ITEMS mutable_graph vertex_list_graph)
    string(REPLACE "${capability};" "" subset "${layout}")
    string(REPLACE "Name_" "caption_" subset "${subset}")
    file(WRITE "${layoutSpec}" "${subset}")
    run(${generate})
    file(READ "${layoutHeader}" emitted)
    if(NOT emitted MATCHES "getCaption[(]" OR emitted MATCHES "getName[(]")
        message(FATAL_ERROR "Named accessors did not follow the component tag")
    endif()
    file(READ "${work}/stage/native/cocos/renderer/pipeline/custom/LayoutGraphTypes.cpp" emittedSource)
    if(NOT emittedSource MATCHES "locate_child[(]" OR NOT emittedSource MATCHES "this->getCaption[(]v[)]"
       OR NOT emittedSource MATCHES "::path[(]" OR emittedSource MATCHES "this->getName[(]")
        message(FATAL_ERROR "Child lookup did not use the selected name component")
    endif()
    if(capability STREQUAL "mutable_graph")
        if(emitted MATCHES "add_vertex[(]" OR NOT emitted MATCHES "num_vertices[(]")
            message(FATAL_ERROR "Removing mutable_graph changed the wrong graph operations")
        endif()
    elseif(emitted MATCHES "vertices[(]" OR NOT emitted MATCHES "add_vertex[(]")
        message(FATAL_ERROR "Removing vertex_list_graph changed the wrong graph operations")
    endif()
    file(READ "${work}/stage/cocos/rendering/custom/layout-graph.ts" script)
    if(script MATCHES "caption_|Descriptors_|Render(Stage|Phase)_" OR NOT script MATCHES "export class LayoutGraph " OR
       NOT script MATCHES "vertexName [(]v: number[)]: string [{] return this.getCaption[(]v[)]" OR
       NOT script MATCHES "this.vertexName[(]v[)] === name" OR NOT script MATCHES "return cc[$]graph.getPath[(]this, v[)]")
        message(FATAL_ERROR "TS graph did not bind the renamed component independently of the native tags")
    endif()
    if(capability STREQUAL "mutable_graph")
        if(script MATCHES "addVertex" OR NOT script MATCHES "nv [(]")
            message(FATAL_ERROR "TS graph did not respect mutable_graph")
        endif()
    elseif(script MATCHES "nv [(]" OR NOT script MATCHES "addVertex")
        message(FATAL_ERROR "TS graph did not respect vertex_list_graph")
    endif()
endforeach()
string(REPLACE "count: uint32_t = 1" "count: uint32_t = 7" changed "${layout}")
file(WRITE "${layoutSpec}" "${changed}")
run(${generate})
file(READ "${work}/stage/cocos/rendering/custom/layout-graph.ts" layoutTs)
foreach(fragment IN ITEMS "    count = 7;" "        this.count = 7;")
    string(FIND "${layoutTs}" "${fragment}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "Partial constructor ignored the changed field default: ${fragment}")
    endif()
endforeach()
string(REPLACE "constructor(type);" "constructor(type); constructor(count);" ambiguous "${layout}")
file(WRITE "${layoutSpec}" "${ambiguous}")
expect_failure(2 "Descriptor: ambiguous partial TypeScript constructor" ${generate})
file(WRITE "${layoutSpec}" "${layout}")

run(${generate})
set(types "${work}/stage/cocos/rendering/custom/types.ts")
set(namesHeader "${work}/stage/native/cocos/renderer/pipeline/custom/RenderCommonNames.h")
file(SHA256 "${types}" beforeTag)
string(REPLACE "@tag struct TextureTag {}" "@tag struct TextureTag {}\n    @tag struct Shared_ {}" tagged "${original}")
file(WRITE "${spec}" "${tagged}")
run(${generate})
file(SHA256 "${types}" afterTag)
if(NOT afterTag STREQUAL beforeTag)
    message(FATAL_ERROR "Adding a tag changed the TypeScript output")
endif()
file(READ "${namesHeader}" cppNames)
string(FIND "${cppNames}" [[getName(const Shared_& /*v*/) noexcept { return "Shared"; }]] at)
if(at EQUAL -1)
    message(FATAL_ERROR "Missing C++ name for the new component tag")
endif()

# Both backends must follow the new declaration order and omit the transient counter.
set(counters "numRenderPasses: uint32_t = 0;\n        numManagedTextures: uint32_t = 0;")
string(REPLACE "${counters}" "numManagedTextures: uint32_t = 0;\n        @transient numRenderPasses: uint32_t = 0;" changed "${original}")
file(WRITE "${spec}" "${changed}")
set(archiveSpec "${work}/spec/render/archive.spec")
file(READ "${archiveSpec}" archiveRules)
string(REPLACE "method writeNumber => n;" "method writeNumber => writeScalar;" renamed "${archiveRules}")
string(REPLACE "method readNumber => n;" "method readNumber => readScalar;" renamed "${renamed}")
file(WRITE "${archiveSpec}" "${renamed}")
run(${generate})
file(READ "${work}/stage/native/cocos/renderer/pipeline/custom/RenderCommonSerialization.cpp" archiveCpp)
file(READ "${types}" archiveTs)
foreach(op IN ITEMS save load)
    string(FIND "${archiveCpp}" "${op}(ar, v.numManagedTextures);\n    // skip, numRenderPasses: uint32_t\n    ${op}(ar, v.totalManagedTextures);" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "C++ ${op} ignored the changed archive schema")
    endif()
endforeach()
foreach(calls IN ITEMS "a.writeScalar(v.numManagedTextures);\n    // skip, v.numRenderPasses: number\n    a.writeScalar(v.totalManagedTextures);"
                      "v.numManagedTextures = a.readScalar();\n    // skip, v.numRenderPasses: number\n    v.totalManagedTextures = a.readScalar();")
    string(FIND "${archiveTs}" "${calls}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "TypeScript archive ignored the changed schema or archive methods")
    endif()
endforeach()
file(WRITE "${archiveSpec}" "${archiveRules}")

# Change the schema to distinguish generated values, overloads and enum members from a template snapshot.
string(REPLACE "uint8_t {" "uint32_t {" changed "${original}")
string(REPLACE "READ_WRITE," [=[@deprecated("Use \"READ\" for */.") MODIFY = 0x10, CHANGE = MODIFY, LEGACY_CHANGE = CHANGE,]=] changed "${changed}")
string(REPLACE "level: uint32_t = 0" "level: uint32_t = 11" changed "${changed}")
string(REPLACE "sourceFirstSlice: uint32_t = 0" "sourceFirstSlice: uint8_t = 0XfF" changed "${changed}")
string(REPLACE "gfx::ResolveMode::SAMPLE_ZERO" "gfx::ResolveMode::AVERAGE" changed "${changed}")
string(REPLACE "constructor(source, target," "constructor(target, source," changed "${changed}")
string(REPLACE "constructor(light, level);" "constructor(level, light);" changed "${changed}")
string(REPLACE "constructor(light, level, culledByLight, probe);" "constructor(light, probe, level, culledByLight);" changed "${changed}")
file(WRITE "${spec}" "${changed}")
string(REGEX REPLACE "    record [A-Za-z]+;\n" "" selected "${changed}")
string(REPLACE "binding jsb {" "binding jsb {\n    record PipelineStatistics;" selected "${selected}")
string(REPLACE "numRenderPasses" "completedPasses" alternate "${selected}")
file(WRITE "${spec}" "${alternate}")
run(${generate})
set(jsbDir "${work}/stage/native/cocos/renderer/pipeline/custom")
file(READ "${jsbDir}/RenderCommonJsb.h" jsbHeader)
file(READ "${jsbDir}/RenderCommonJsb.cpp" jsbSource)
if(NOT jsbHeader MATCHES "cc::render::PipelineStatistics" OR jsbHeader MATCHES "cc::render::LightInfo"
   OR jsbSource MATCHES "numRenderPasses|cc::render::LightInfo")
    message(FATAL_ERROR "JSB converters ignored the record selection or field rename")
endif()
foreach(fragment IN ITEMS [[obj->setProperty("completedPasses", tmp)]] [[obj->getProperty("completedPasses", &field, true)]])
    string(FIND "${jsbSource}" "${fragment}" pos)
    if(pos EQUAL -1)
        message(FATAL_ERROR "Missing JSB property access: ${fragment}")
    endif()
endforeach()
string(REPLACE " => const enum;" " => enum;" both "${changed}")
string(REPLACE "UpdateFrequency => enum" "AccessType => const enum { names; };\n    UpdateFrequency => enum" both "${both}")
file(WRITE "${spec}" "${both}")
run(${generate})
file(READ "${work}/stage/native/cocos/renderer/pipeline/custom/RenderCommonTypes.h" cpp)
file(READ "${work}/stage/cocos/rendering/custom/types.ts" ts)
set(memberDoc [=[    /**
     * @deprecated Use "READ" for *&#47;.
     */
    MODIFY = 0x10,]=])
foreach(output IN ITEMS cpp ts)
    string(FIND "${${output}}" "${memberDoc}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "Missing deprecation comment on MODIFY in ${output}")
    endif()
endforeach()
foreach(fragment IN ITEMS "enum class AccessType : uint32_t" "MODIFY = 0x10," "LEGACY_CHANGE = CHANGE," "uint32_t level{11};"
                          "uint8_t sourceFirstSlice{0XfF};" "uint32_t mipLevels{0xFFFFFFFF};"
                          "gfx::ResolveMode mode{gfx::ResolveMode::AVERAGE};" "ResolvePair(ccstd::pmr::string targetIn, ccstd::pmr::string sourceIn,"
                          "LightInfo(uint32_t levelIn, IntrusivePtr<scene::Light> lightIn)")
    string(FIND "${cpp}" "${fragment}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "Missing C++ fragment: ${fragment}")
    endif()
endforeach()
foreach(fragment IN ITEMS "export const enum AccessType {" "export enum ParameterType {" "MODIFY = 0x10," "LEGACY_CHANGE = CHANGE," "level = 11"
                          "sourceFirstSlice = 0XfF" "mipLevels = 0xFFFFFFFF"
                          "mode: ResolveMode = ResolveMode.AVERAGE" "v.reset(target, source, resolveFlags, mode, mode1);"
                          "constructor (light: Light | null = null, probe: ReflectionProbe | null = null, level = 11, culledByLight = false)")
    string(FIND "${ts}" "${fragment}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "Missing TS fragment: ${fragment}")
    endif()
endforeach()

file(READ "${work}/stage/cocos/rendering/custom/types-names.ts" names)
foreach(fragment IN ITEMS "import { UpdateFrequency, AccessType } from './types'" "getAccessTypeName (e: AccessType)"
                          "case AccessType.MODIFY:" "return 'MODIFY'")
    string(FIND "${names}" "${fragment}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "Missing TS name lookup fragment: ${fragment}")
    endif()
endforeach()
if(names MATCHES "case AccessType[.](CHANGE|LEGACY_CHANGE):")
    message(FATAL_ERROR "Alias duplicated the original member's name lookup case")
endif()
file(READ "${namesHeader}" cppNames)
string(FIND "${cppNames}" [[case AccessType::MODIFY: return "MODIFY";]] at)
if(at EQUAL -1 OR cppNames MATCHES "case AccessType::(CHANGE|LEGACY_CHANGE):")
    message(FATAL_ERROR "C++ name lookup must use the first declaration of each enum value")
endif()
function(bad_binding before after error)
    string(REPLACE "${before}" "${after}" broken "${original}")
    file(WRITE "${spec}" "${broken}")
    expect_failure(2 "${error}" ${generate})
endfunction()
bad_binding("UpdateFrequency => enum" "LightInfo => enum" "expected an enum binding")
bad_binding("record LightInfo;" "record MissingRecord;" "unknown type MissingRecord")
bad_binding("record LightInfo;" "record QueueHint;" "expected a local JSB record QueueHint")
bad_binding("ParameterType => const enum;" "BufferTag => const enum;" "expected an enum binding")
bad_binding("PipelineStatistics => class" "MissingStats => class" "unknown type MissingStats")
bad_binding("pool ps;" "pool ps keep(numRenderPasses);" "PipelineStatistics: resetToDefaults conflicts with keepOnReset")
bad_binding("keep(source)" "keep(source, missing)" "UploadPair: unknown keepOnReset field missing")
bad_binding("pool up keep(source);" "pool up;" "UploadPair.source: reset requires a writable field")
bad_binding("pool rp;" "pool li;" "duplicate pool member li")
bad_binding("record LightInfo;" "record LightInfo; record cc::render::LightInfo;" "duplicate JSB record")
bad_binding("pool li;" "pool li; pool another;" "duplicate binding option pool")
string(REPLACE "    @tag struct BufferTag {}" "    @tag struct BufferTag { value: uint32_t; }" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "render-common.spec:[0-9]+:[0-9]+: expected '}'" ${generate})
string(REPLACE "numRenderPasses: uint32_t" "readonly numRenderPasses: uint32_t" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "numRenderPasses: archive load requires a writable field" ${generate})
string(REPLACE "@serialize struct PipelineStatistics" "struct PipelineStatistics" broken "${broken}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "PipelineStatistics.numRenderPasses: reset requires a writable field" ${generate})
string(REPLACE "@transient\n        nullable light" "nullable light" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "light: unsupported archive field type" ${generate})
string(REPLACE "enum class AccessType" "@moveOnly enum class AccessType" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "render-common.spec:[0-9]+:[0-9]+: @moveOnly requires a struct" ${generate})
string(REPLACE "gfx::ResolveMode::SAMPLE_ZERO" "gfx::ResolveMode::MISSING" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "invalid enum default gfx::ResolveMode::MISSING" ${generate})

string(REPLACE [=["Please use OPAQUE."]=] [=["Please use OPAQUE.]=] broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "render-common[.]spec:[0-9]+:[0-9]+: unterminated deprecation message" ${generate})

foreach(target IN ITEMS MISSING ALIAS LATER FOREIGN)
    file(WRITE "${spec}" "module RenderCommon;
namespace cc::render {
    enum class Other { FOREIGN }
    enum class QueueHint {
        BASE,
        ALIAS = ${target},
        LATER,
    }
}
binding jsb {}
")
    expect_failure(2 "render-common[.]spec:6:17: QueueHint[.]ALIAS must refer to an earlier member of the same enum: ${target}" ${generate})
endforeach()

foreach(literal IN ITEMS 0x100000000 4294967296 -1)
    string(REPLACE "UNIFORM = 0x1," "UNIFORM = ${literal}," broken "${original}")
    file(WRITE "${spec}" "${broken}")
    expect_failure(2 "render-common[.]spec:[0-9]+:19: enum value out of range for uint32_t: UNIFORM" ${generate})
endforeach()
foreach(literal IN ITEMS 0x 0xG 01 1.5)
    string(REPLACE "UNIFORM = 0x1," "UNIFORM = ${literal}," broken "${original}")
    file(WRITE "${spec}" "${broken}")
    expect_failure(2 "render-common[.]spec:[0-9]+:19: invalid integer literal" ${generate})
endforeach()
string(REPLACE "TRANSFER_DST = 0x200," "TOP = 0xFFFFFFFF, NEXT," broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "enum value out of range for uint32_t: NEXT" ${generate})

function(expect_bad_shift expression column message)
    string(REPLACE "DEPTH = 1 << 1," "DEPTH = ${expression}," broken "${original}")
    file(WRITE "${spec}" "${broken}")
    expect_failure(2 "render-common[.]spec:[0-9]+:${column}: ${message}" ${generate})
endfunction()
expect_bad_shift("1 << -1" 22 "expected nonnegative integer shift count")
expect_bad_shift("1 << 32" 22 "shift count out of range for uint32_t")
expect_bad_shift("1 << 1.5" 22 "invalid integer shift count")
expect_bad_shift("1 << " 22 "expected nonnegative integer shift count")
expect_bad_shift("2 << 31" 17 "enum value out of range for uint32_t")
expect_bad_shift("-1 << 0" 17 "expected nonnegative left shift operand")

string(REPLACE "constructor(light, level);" "constructor(light, missing);" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "render-common.spec:[0-9]+:[0-9]+: unknown constructor field missing" ${generate})
string(REPLACE "enum class AccessType : uint8_t" "enum class AccessType : float" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "expected integral enum base" ${generate})
string(REPLACE "level: uint32_t = 0" "level: uint32_t = -1" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "level: unsupported scalar default -1" ${generate})
foreach(literal IN ITEMS 0x100000000 0x 0X12G -0x1)
    string(REPLACE "mipLevels: uint32_t = 0xFFFFFFFF" "mipLevels: uint32_t = ${literal}" broken "${original}")
    file(WRITE "${spec}" "${broken}")
    expect_failure(2 "render-common.spec:[0-9]+:[0-9]+: mipLevels: invalid uint32_t default ${literal}" ${generate})
endforeach()
string(REPLACE "sourceFirstSlice: uint32_t = 0" "sourceFirstSlice: uint8_t = 0x100" broken "${original}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "sourceFirstSlice: invalid uint8_t default 0x100" ${generate})
# The C++-only backend must bind native method types from the spec without TS mappings.
set(spec "${work}/spec/codegen/source-location.spec")
file(READ "${spec}" original)
string(REPLACE "describe() const" "format(prefix: std::string) const noexcept" changed "${original}")
file(WRITE "${spec}" "${changed}")
set(generate "${TOOL}" generate --workspace "${work}/config/self-host.json" --output "${work}/native")
run(${generate})
file(READ "${work}/native/generated/SourceLocation.h" header)
string(FIND "${header}" "std::string format(std::string prefix) const noexcept;" at)
if(at EQUAL -1)
    message(FATAL_ERROR "Native method signature did not follow the spec")
endif()
string(REPLACE "prefix: std::string" "prefix: MissingType" broken "${changed}")
file(WRITE "${spec}" "${broken}")
expect_failure(2 "source-location.spec:[0-9]+:[0-9]+: unknown type MissingType" ${generate})
finish_workspace("${work}")

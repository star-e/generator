# One-time import from a previously generated C++ project. Regular builds consume the snapshot.
cmake_minimum_required(VERSION 3.24)
foreach(arg INPUT_DIR OUTPUT_DIR RUNTIME_NAMESPACE)
    if(NOT DEFINED ${arg} OR "${${arg}}" STREQUAL "")
        message(FATAL_ERROR "Set ${arg} explicitly")
    endif()
endforeach()
if(NOT RUNTIME_NAMESPACE MATCHES "^[a-zA-Z_][a-zA-Z0-9_]*$")
    message(FATAL_ERROR "Expected one runtime namespace identifier")
endif()

set(files TypeGraphFwd.h TypeGraphDependencies.h TypeGraphTypes.h TypeGraphTypes.cpp)
foreach(file IN LISTS files)
    file(READ "${INPUT_DIR}/${file}" source)
    # GraphSupport.h supplies the range and edge types for the three runtime includes.
    if(file STREQUAL "TypeGraphDependencies.h")
        string(REGEX REPLACE "#include \"${RUNTIME_NAMESPACE}/[^\"]*/[A-Za-z]*(GraphTypes|Iterator|IteratorPair)\\.h\"[^\n]*\n" "" source "${source}")
    endif()
    foreach(helper IntegerIterator EdgeDescriptor OutEdgeIterator InEdgeIterator IteratorPair)
        string(REPLACE "${RUNTIME_NAMESPACE}::${helper}" "cc::codegen::graph::${helper}" source "${source}")
    endforeach()
    if(source MATCHES "${RUNTIME_NAMESPACE}(::|/)")
        message(FATAL_ERROR "Unmapped runtime dependency in ${file}")
    endif()
    set("seed_${file}" "${source}")
endforeach()

file(MAKE_DIRECTORY "${OUTPUT_DIR}")
foreach(file IN LISTS files)
    set(path "${OUTPUT_DIR}/${file}")
    string(SHA256 expected "${seed_${file}}")
    if(EXISTS "${path}")
        file(SHA256 "${path}" actual)
        if(actual STREQUAL expected)
            continue()
        endif()
    endif()
    file(WRITE "${path}" "${seed_${file}}")
endforeach()

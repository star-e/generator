function(read_self_host_paths manifest result)
    file(READ "${manifest}" json)
    string(JSON version GET "${json}" schemaVersion)
    if(NOT version STREQUAL "1")
        message(FATAL_ERROR "${manifest}: unsupported schemaVersion ${version}")
    endif()
    string(JSON count LENGTH "${json}" files)
    set(paths)
    set(i 0)
    while(i LESS count)
        string(JSON path MEMBER "${json}" files ${i})
        if(NOT path MATCHES "^generated/" OR path MATCHES [[(/\.\.?(/|$)|[\\:;])]])
            message(FATAL_ERROR "${manifest}: invalid self-host output path '${path}'")
        endif()
        list(APPEND paths "${path}")
        math(EXPR i "${i} + 1")
    endwhile()
    set(${result} "${paths}" PARENT_SCOPE)
endfunction()
